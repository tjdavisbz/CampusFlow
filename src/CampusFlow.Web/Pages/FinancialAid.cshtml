@page
@model CampusFlow.Web.Pages.FinancialAidModel
@using CampusFlow.Web.Pages
@using CampusFlow.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = "Financial Aid";
    PageLayout.Content.BreadCrumb.ShowCurrent = false;
    PageLayout.Content.ShowToolbar = false;
    PageLayout.Content.MenuItemName = CampusFlowMenus.FinancialAid;
}

@section styles {
    @if (!string.IsNullOrWhiteSpace(Model.Theme.FontStylesheetUrl))
    {
        <link rel="stylesheet" href="@Model.Theme.FontStylesheetUrl" />
    }
    <abp-style src="/Pages/FinancialAid.css" />
    <style>
        :root {
            --tenant-primary: @Model.Theme.PrimaryColor;
            --tenant-primary-dark: @Model.Theme.PrimaryDarkColor;
            --tenant-accent: @Model.Theme.AccentColor;
            --tenant-surface: @Model.Theme.SurfaceColor;
            --tenant-text: @Model.Theme.TextColor;
            --tenant-heading-font: @Model.Theme.HeadingFontFamily;
            --tenant-body-font: @Model.Theme.BodyFontFamily;
        }
    </style>
}

@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const dialog = document.getElementById("aid-decision-dialog");
            const form = document.getElementById("aid-decision-form");
            const title = document.getElementById("aid-dialog-title");
            const message = document.getElementById("aid-dialog-message");
            const awardName = document.getElementById("aid-dialog-award");
            const awardAmount = document.getElementById("aid-dialog-amount");
            const decisionInput = document.getElementById("aid-dialog-decision");
            const awardInput = document.getElementById("aid-dialog-award-id");
            const submitButton = document.getElementById("aid-dialog-submit");

            document.querySelectorAll("[data-aid-decision]").forEach(button => {
                button.addEventListener("click", () => {
                    const decision = button.dataset.aidDecision;
                    const isDecline = decision === "Decline";
                    title.textContent = isDecline ? "Decline this award?" : "Accept this award?";
                    message.textContent = isDecline
                        ? "This award will not be available toward your student account."
                        : "This award will be marked as accepted in Elements.";
                    awardName.textContent = button.dataset.awardName;
                    awardAmount.textContent = button.dataset.awardAmount;
                    decisionInput.value = decision;
                    awardInput.value = button.dataset.awardId;
                    submitButton.textContent = isDecline ? "Yes, decline award" : "Yes, accept award";
                    submitButton.classList.toggle("decline", isDecline);
                    dialog.classList.toggle("decline", isDecline);
                    dialog.showModal();
                });
            });

            document.getElementById("aid-dialog-cancel").addEventListener("click", () => dialog.close());
            dialog.addEventListener("click", event => {
                if (event.target === dialog) dialog.close();
            });
        });
    </script>
}

<main class="aid-page">
    <header class="aid-header">
        <div>
            <div class="aid-eyebrow">Student funding</div>
            <h1>Financial Aid</h1>
            <p>Review your awards, decisions, and student account status.</p>
        </div>
        <div class="aid-student"><span>@Model.StudentDisplayName</span><strong>ID @Model.StudentIdentifier</strong></div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="aid-alert @(Model.StatusIsError ? "error" : "success")" role="status">@Model.StatusMessage</div>
    }

    @if (Model.IsUnavailable)
    {
        <section class="aid-message" role="status"><i class="fa-regular fa-circle-exclamation"></i><div><h2>Financial aid information is temporarily unavailable</h2><p>Please try again shortly.</p></div></section>
    }
    else if (Model.Terms.Count == 0)
    {
        <section class="aid-message"><i class="fa-solid fa-graduation-cap"></i><div><h2>No awards to display</h2><p>Financial aid awards will appear here when they are available.</p></div></section>
    }
    else
    {
        <section class="aid-summary">
            <div><span>Total awards</span><strong>@FinancialAidModel.FormatCurrency(Model.TotalAwards)</strong></div>
            <p>Across all terms currently shown</p>
        </section>

        <section class="aid-awards" aria-labelledby="awards-heading">
            <div class="aid-section-heading"><div><span>Awards &amp; scholarships</span><h2 id="awards-heading">My financial aid</h2></div></div>
            @foreach (var term in Model.Terms)
            {
                <details class="aid-term" open>
                    <summary>
                        <div><strong>@term.TermName</strong><span>@term.Awards.Count award@(term.Awards.Count == 1 ? "" : "s")</span></div>
                        <div class="aid-term-total"><strong>@FinancialAidModel.FormatCurrency(term.TotalAmount)</strong><i class="fa-solid fa-chevron-down"></i></div>
                    </summary>
                    <div class="award-grid">
                        @foreach (var award in term.Awards)
                        {
                            <article class="award-card">
                                <div class="award-topline"><span>@award.AwardType</span><strong>@FinancialAidModel.FormatCurrency(award.Amount)</strong></div>
                                <h3>@award.Description</h3>
                                <div class="award-meta">
                                    <span><i class="fa-regular fa-calendar"></i>@(award.AwardDate?.ToString("MMM d, yyyy") ?? "Date unavailable")</span>
                                    <span><i class="fa-regular fa-circle-check"></i>@award.AwardStatus</span>
                                </div>
                                <div class="award-footer">
                                    <span class="billing-status @(award.IsSentToBilling ? "sent" : "anticipated")">
                                        <i class="fa-solid @(award.IsSentToBilling ? "fa-building-columns" : "fa-clock")"></i>
                                        @(award.IsSentToBilling ? "Sent to student accounts" : "Anticipated aid")
                                    </span>
                                    <div class="award-actions" aria-label="Award decision">
                                        @if (award.Amount <= 0 || award.AwardStatus.Contains("Cancel", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="decision-recorded unavailable"><i class="fa-solid fa-ban"></i> Not available</span>
                                        }
                                        else if (award.StudentAccepted is 0 or 1)
                                        {
                                            <span class="decision-recorded"><i class="fa-solid fa-lock"></i> @(award.StudentAccepted == 1 ? "Accepted" : "Declined")</span>
                                        }
                                        else
                                        {
                                            <button type="button" data-aid-decision="Accept" data-award-id="@award.ExternalAwardId" data-award-name="@award.Description" data-award-amount="@FinancialAidModel.FormatCurrency(award.Amount)">Accept</button>
                                            <button type="button" class="decline" data-aid-decision="Decline" data-award-id="@award.ExternalAwardId" data-award-name="@award.Description" data-award-amount="@FinancialAidModel.FormatCurrency(award.Amount)">Decline</button>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </details>
            }
        </section>
        <p class="aid-note"><i class="fa-solid fa-circle-info"></i> Awards already accepted or declined can only be changed by the Financial Aid Office.</p>
    }

    <dialog id="aid-decision-dialog" class="aid-dialog" aria-labelledby="aid-dialog-title">
        <form id="aid-decision-form" method="post" asp-page-handler="Decision">
            <input id="aid-dialog-award-id" type="hidden" name="awardId" />
            <input id="aid-dialog-decision" type="hidden" name="decision" />
            <div class="aid-dialog-icon"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></div>
            <div class="aid-dialog-heading">
                <span>Financial aid decision</span>
                <h2 id="aid-dialog-title">Confirm your decision</h2>
                <p id="aid-dialog-message"></p>
            </div>
            <div class="aid-dialog-award">
                <div><span>Award</span><strong id="aid-dialog-award"></strong></div>
                <strong id="aid-dialog-amount"></strong>
            </div>
            <p class="aid-dialog-warning"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> After submitting, contact the Financial Aid Office if you need to change this decision.</p>
            <div class="aid-dialog-actions">
                <button id="aid-dialog-cancel" type="button" class="secondary">Go back</button>
                <button id="aid-dialog-submit" type="submit">Confirm decision</button>
            </div>
        </form>
    </dialog>
</main>
