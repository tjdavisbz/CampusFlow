@page "/Advisor/Review"
@model CampusFlow.Web.Pages.Advisor.ReviewModel
@using CampusFlow.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = "Review courses";
    PageLayout.Content.BreadCrumb.ShowCurrent = false;
    PageLayout.Content.ShowToolbar = false;
    PageLayout.Content.MenuItemName = CampusFlowMenus.AdvisorQueue;
}

@section styles {
    <abp-style src="/Pages/Advisor/Advisor.css" />
    <style>:root { --advisor-primary: @Model.Theme.PrimaryColor; --advisor-dark: @Model.Theme.PrimaryDarkColor; --advisor-accent: @Model.Theme.AccentColor; }</style>
}

<main class="advisor-shell">
    <a class="back-link" asp-page="/Advisor/Index"><i class="fa-solid fa-arrow-left"></i> Back to review queue</a>
    <header class="review-hero">
        <div><span>Course review</span><h1>@Model.Review.StudentName <span class="graduation-intent @(Model.Review.IntendsToGraduate == true ? "is-yes" : Model.Review.IntendsToGraduate == false ? "is-no" : "is-unanswered")">Graduating: @(Model.Review.IntendsToGraduate == true ? "Yes" : Model.Review.IntendsToGraduate == false ? "No" : "Not answered")</span></h1><p>ID @Model.Review.StudentId · @Model.Review.AttendanceType</p></div>
        <div class="queue-count"><strong>@Model.Review.Courses.Count</strong><span>pending courses</span></div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.EmailNotice))
    {
        <section class="advisor-card" role="status"><p>@Model.EmailNotice</p></section>
    }
    @if (Model.FailedEmailSubmissionId.HasValue)
    {
        <section class="advisor-card">
            <div class="card-heading"><div><span>Delivery not complete</span><h2>@Model.EmailSubject</h2></div></div>
            <div class="advisor-email-preview">@Html.Raw(Model.EmailPreviewHtml)</div>
            <form method="post" asp-page-handler="RetryEmail">
                <input type="hidden" name="submissionId" value="@Model.FailedEmailSubmissionId" />
                <button type="submit" class="advisor-primary">Retry delivery</button>
            </form>
        </section>
    }
    else
    {

    <form method="post" id="advisorReviewForm">
        <fieldset disabled="@Model.IsReadOnlySchedulerView" style="border:0;padding:0;margin:0;min-width:0">
        <input asp-for="Input.StudentProfileId" type="hidden" />
        <input asp-for="Input.ExternalTermId" type="hidden" />
        <section class="advisor-card">
            <div class="card-heading"><div><span>Current schedule</span><h2>Courses already on the student's schedule</h2></div><p>Approved and directly added courses are shown here for context. They are not part of this review.</p></div>
            @if (Model.Review.ExistingCourses.Count == 0)
            {
                <p>No other courses are currently on this student's schedule.</p>
            }
            else
            {
                <div class="review-list">
                    @foreach (var course in Model.Review.ExistingCourses)
                    {
                        <article class="review-course">
                            <div class="course-heading"><div><span>@course.CourseCode-@course.Section</span><h3>@course.CourseName</h3></div><strong>@course.Credits.ToString("0.##") credits</strong></div>
                            <div class="course-meta"><span><i class="fa-solid fa-check"></i> On schedule · @course.Status</span></div>
                        </article>
                    }
                </div>
            }
        </section>
        <section class="advisor-card">
            <div class="card-heading"><div><span>Selected schedule</span><h2>Review each course</h2></div><p>You may decide some courses now and leave the others pending.</p></div>
            <div class="review-list">
                @for (var i = 0; i < Model.Review.Courses.Count; i++)
                {
                    var course = Model.Review.Courses[i];
                    <article class="review-course">
                        <input asp-for="Input.Courses[i].ReviewId" type="hidden" value="@course.ReviewId" />
                        <div class="course-heading">
                            <div><span>@course.CourseCode-@course.Section</span><h3>@course.CourseName</h3></div>
                            <strong>@course.Credits.ToString("0.##") credits</strong>
                        </div>
                        <div class="course-meta">
                            @if (!string.IsNullOrWhiteSpace(course.InstructorName)) { <span><i class="fa-regular fa-user"></i> @course.InstructorName</span> }
                            @if (!string.IsNullOrWhiteSpace(course.MeetingDays)) { <span><i class="fa-regular fa-clock"></i> @course.MeetingDays</span> }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(course.LastRemovalError))
                        {
                            <div class="retry-warning"><i class="fa-solid fa-triangle-exclamation"></i> A previous removal attempt failed. You can reject again to retry.</div>
                        }
                        <fieldset class="decision-control">
                            <legend>Decision</legend>
                            <label><input asp-for="Input.Courses[i].Decision" type="radio" value="" /> Decide later</label>
                            <label class="approve"><input asp-for="Input.Courses[i].Decision" type="radio" value="Approve" /> Approve</label>
                            <label class="reject"><input asp-for="Input.Courses[i].Decision" type="radio" value="Reject" /> Reject</label>
                        </fieldset>
                        <label class="comment-field">Comment for this course <span>Optional</span><textarea asp-for="Input.Courses[i].Comment" rows="2" maxlength="4000" placeholder="Add context for the student"></textarea></label>
                    </article>
                }
            </div>
        </section>
        <section class="advisor-card overall-card">
            <div><span>Advisor notes</span><h2>Message to the student</h2><p>This message appears at the bottom of the email and is saved to Student Notes as Scheduler Comments for this term.</p></div>
            <textarea asp-for="Input.OverallComment" rows="4" maxlength="4000" placeholder="Add an overall note about the student's schedule"></textarea>
        </section>
        @if (!Model.MailConnected)
        {
            <p class="advisor-mail-hint">Previewing may ask you to approve sending mail from your Nelson Microsoft account. Your review will be kept while you approve it.</p>
        }
        <div asp-validation-summary="All" class="advisor-errors" role="alert"></div>
        @if (Model.PreviewReady)
        {
            <section class="advisor-card">
                <div class="card-heading"><div><span>Email preview</span><h2>@Model.EmailSubject</h2></div><p>This is the proposed message. Saving will use the actual results recorded in Elements and CampusFlow.</p></div>
                <div class="advisor-email-preview">@Html.Raw(Model.EmailPreviewHtml)</div>
            </section>
        }
        <div class="submit-bar"><a asp-page="/Advisor/Index">Cancel</a><button type="submit" asp-page-handler="Preview"><i class="fa-regular fa-eye"></i> Preview email</button>@if (Model.PreviewReady && Model.MailConnected){<button type="submit" asp-page-handler="Submit" data-action="submit-review"><i class="fa-solid fa-check"></i> Save review and email student</button>}</div>
        </fieldset>
    </form>
    }
</main>

<div class="advisor-processing" id="advisorProcessing" hidden><div><span></span><h2>Recording your review</h2><p>Please wait while course decisions are completed.</p></div></div>

<div class="advisor-confirm" id="rejectConfirmation" hidden role="dialog" aria-modal="true" aria-labelledby="rejectTitle">
    <div class="advisor-confirm-card">
        <div class="confirm-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div><span>Confirm course rejection</span><h2 id="rejectTitle">Remove rejected courses?</h2><p>Rejected courses will be removed from the student's Elements schedule. Courses left undecided will remain in the queue.</p></div>
        <div class="confirm-actions"><button type="button" id="keepReview">Go back</button><button type="button" class="danger" id="confirmReview">Yes, submit review</button></div>
    </div>
</div>

@section scripts {
    <script>
        (() => {
            const form = document.getElementById('advisorReviewForm');
            const confirmation = document.getElementById('rejectConfirmation');
            const processing = document.getElementById('advisorProcessing');
            let confirmed = false;
            form?.addEventListener('submit', event => {
                if (event.submitter?.dataset.action !== 'submit-review') return;
                if (confirmed) {
                    processing.hidden = false;
                    return;
                }
                const rejected = [...document.querySelectorAll('input[type="radio"][value="Reject"]:checked')];
                if (!rejected.length) {
                    processing.hidden = false;
                    return;
                }
                event.preventDefault();
                confirmation.hidden = false;
                document.body.classList.add('modal-open');
                document.getElementById('keepReview').focus();
            });
            document.getElementById('keepReview')?.addEventListener('click', () => {
                confirmation.hidden = true;
                document.body.classList.remove('modal-open');
            });
            document.getElementById('confirmReview')?.addEventListener('click', () => {
                confirmed = true;
                confirmation.hidden = true;
                document.body.classList.remove('modal-open');
                form.requestSubmit(form.querySelector('[data-action="submit-review"]'));
            });
        })();
    </script>
}
