@page "/Faculty/advising"
@model CampusFlow.Web.Pages.Faculty.AdvisingModel
@using CampusFlow.Web.Pages
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = "My Advisees";
    PageLayout.Content.BreadCrumb.ShowCurrent = false;
    PageLayout.Content.ShowToolbar = false;
    PageLayout.Content.MenuItemName = "CampusFlow.Faculty.advising";
}

@section styles { <abp-style src="/Pages/Faculty/Faculty.css" /> }

<main class="faculty-shell faculty-advising">
    <header class="faculty-hero"><span>Faculty portal</span><h1>My Advisees</h1><p>Review the degree audits of students assigned to you as an advisor.</p></header>
    <nav class="faculty-tabs" aria-label="Faculty pages">
        <a href="/Faculty?term=@Model.SelectedTerm?.Id">Home</a>
        <a href="/Faculty/students?term=@Model.SelectedTerm?.Id">My Students</a>
        <a href="/Faculty/schedule?term=@Model.SelectedTerm?.Id">My Schedule</a>
        <a href="/Faculty/roster?term=@Model.SelectedTerm?.Id">Class Roster</a>
        <a href="/Faculty/courses?term=@Model.SelectedTerm?.Id">My Courses</a>
        <a class="active" href="/Faculty/advising?term=@Model.SelectedTerm?.Id">My Advisees</a>
        @if (!CampusFlow.Web.Portals.FacultyViewSession.GetFacultyId(ViewContext.HttpContext).HasValue)
        {
            <a href="/Faculty/email?term=@Model.SelectedTerm?.Id">Email Students</a>
        }
    </nav>

    <form method="get" class="faculty-term"><label for="advising-term">Term</label>
        <select id="advising-term" name="term" onchange="this.form.submit()">
            @foreach (var option in Model.Terms)
            {
                <option value="@option.Id" selected="@(option.Id == Model.SelectedTerm?.Id)">@option.Name</option>
            }
        </select>
        <noscript><button type="submit">Show term</button></noscript>
    </form>

    @if (Model.SelectedTerm is null)
    {
        <section class="faculty-card"><p>No advising terms are available yet.</p></section>
    }
    else
    {
        <section class="faculty-card faculty-advisee-list"><h2>Advisees · @Model.SelectedTerm.Name</h2>
            <p>Students appear here when your Elements advisor record is assigned to one of their programs for this term.</p>
            @if (Model.Advisees.Count == 0)
            {
                <p>No advisees are assigned to you for this term.</p>
            }
            else
            {
                <label class="faculty-advisee-search" for="advisee-filter">Find an advisee
                    <input id="advisee-filter" type="search" placeholder="Name, student ID, or program" oninput="document.querySelectorAll('[data-advisee]').forEach(row => row.hidden = !row.textContent.toLowerCase().includes(this.value.trim().toLowerCase()))" />
                </label>
                <div class="faculty-table-wrap"><table><thead><tr><th>Student</th><th>ID</th><th>Program</th><th></th></tr></thead><tbody>
                    @foreach (var advisee in Model.Advisees)
                    {
                        <tr data-advisee class="@(Model.SelectedStudent?.StudentUid == advisee.StudentUid ? "faculty-selected-row" : "")">
                            <td><strong>@advisee.Name</strong></td><td>@advisee.StudentId</td><td>@advisee.Programs</td>
                            <td><a asp-page="/Faculty/Advising" asp-route-term="@Model.SelectedTerm.Id" asp-route-student="@advisee.StudentUid">View audit</a></td>
                        </tr>
                    }
                </tbody></table></div>
            }
        </section>
    }

    @if (Model.SelectedStudent is not null)
    {
        <section class="faculty-card faculty-audit" id="degree-audit">
            <div class="faculty-audit-heading"><div><span>Degree audit</span><h2>@Model.SelectedStudent.Name</h2><p>ID @Model.SelectedStudent.StudentId · @Model.SelectedTerm?.Name</p></div>
                @if (Model.SelectedAudit is not null) { <button type="button" class="faculty-primary faculty-print" onclick="window.print()">Print audit</button> }
            </div>
            @if (Model.AuditUnavailable)
            {
                <p>The degree audit could not be loaded right now. Please try again later.</p>
            }
            else if (Model.Audits.Count == 0)
            {
                <p>No degree audit is available for this student in Elements.</p>
            }
            else if (Model.SelectedAudit is not null)
            {
                @if (Model.Audits.Count > 1)
                {
                    <nav class="faculty-audit-programs" aria-label="Degree programs">
                        @foreach (var audit in Model.Audits)
                        {
                            <a class="@(audit.AuditProgramId == Model.SelectedAudit.Summary.AuditProgramId && audit.AuditDegreeId == Model.SelectedAudit.Summary.AuditDegreeId && audit.RevisionTermId == Model.SelectedAudit.Summary.RevisionTermId ? "active" : "")"
                               asp-page="/Faculty/Advising" asp-route-term="@Model.SelectedTerm?.Id" asp-route-student="@Model.SelectedStudent.StudentUid"
                               asp-route-revisionTermId="@audit.RevisionTermId" asp-route-auditDegreeId="@audit.AuditDegreeId" asp-route-auditProgramId="@audit.AuditProgramId">@audit.Program · @audit.RevisionTerm</a>
                        }
                    </nav>
                }
                var summary = Model.SelectedAudit.Summary;
                <div class="faculty-audit-summary"><h3>@summary.Degree · @summary.Program</h3><p>@summary.RevisionTerm catalog · @summary.Status</p>
                    <dl><div><dt>Credits completed</dt><dd>@DegreeAuditModel.Number(summary.CreditsCompleted) / @DegreeAuditModel.Number(summary.CreditsRequired)</dd></div>
                        <div><dt>Degree audit GPA</dt><dd>@summary.GpaAttained.ToString("0.00")</dd></div></dl>
                </div>
                @if (summary.NeedsUpdate)
                {
                    <p class="faculty-audit-warning" role="status">Elements marks this audit as needing an update. This is the latest calculated audit currently available; verify it in Elements before relying on it.</p>
                }
                @foreach (var requirement in Model.SelectedAudit.Courses.GroupBy(x => new { x.RequirementName, x.RequirementSortOrder, x.RequirementStatus, x.RequirementCreditsRequired, x.RequirementCreditsCompleted }).OrderBy(x => x.Key.RequirementSortOrder))
                {
                    <section class="faculty-audit-requirement"><h3>@requirement.Key.RequirementName</h3>
                        <p>@DegreeAuditModel.StatusLabel(requirement.Key.RequirementStatus) · @DegreeAuditModel.Number(requirement.Key.RequirementCreditsCompleted) of @DegreeAuditModel.Number(requirement.Key.RequirementCreditsRequired) credits</p>
                        @foreach (var group in requirement.GroupBy(x => new { x.GroupName, x.GroupSortOrder, x.GroupStatus, x.GroupCreditsRequired, x.GroupCreditsCompleted }).OrderBy(x => x.Key.GroupSortOrder))
                        {
                            var visibleCourses = DegreeAuditDisplay.CoursesForGroup(group, Model.SelectedAudit.Courses);
                            <h4>@group.Key.GroupName <small>· @DegreeAuditModel.StatusLabel(group.Key.GroupStatus) · @DegreeAuditModel.Number(group.Key.GroupCreditsCompleted) / @DegreeAuditModel.Number(group.Key.GroupCreditsRequired) credits</small></h4>
                            <div class="faculty-table-wrap"><table><thead><tr><th>Course</th><th>Name</th><th>Term</th><th>Credits</th><th>Grade</th><th>Status</th></tr></thead><tbody>
                                @if (visibleCourses.Count == 0)
                                {
                                    <tr><td colspan="6">No electives completed or in progress yet.</td></tr>
                                }
                                @foreach (var course in visibleCourses)
                                {
                                    <tr><td>@(string.IsNullOrWhiteSpace(course.CourseCode) ? "Requirement" : course.CourseCode)</td><td>@course.CourseName</td><td>@course.Term</td>
                                        <td>@DegreeAuditModel.Number(course.Credits)</td><td>@course.Grade</td><td>@DegreeAuditModel.StatusLabel(course.CourseStatus)</td></tr>
                                }
                            </tbody></table></div>
                        }
                    </section>
                }
            }
        </section>
    }
</main>
