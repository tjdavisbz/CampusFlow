@page
@model CampusFlow.Web.Pages.BillApprovalModel
@using CampusFlow.Web.Pages
@using CampusFlow.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = "Bill Approval";
    PageLayout.Content.BreadCrumb.ShowCurrent = false;
    PageLayout.Content.ShowToolbar = false;
    PageLayout.Content.MenuItemName = CampusFlowMenus.BillApproval;
}

@section styles {
    @if (!string.IsNullOrWhiteSpace(Model.Theme.FontStylesheetUrl)) { <link rel="stylesheet" href="@Model.Theme.FontStylesheetUrl" /> }
    <abp-style src="/Pages/BillApproval.css" />
    <abp-style src="/Pages/BillApprovalPlan.css" />
    <style>:root { --tenant-primary: @Model.Theme.PrimaryColor; --tenant-primary-dark: @Model.Theme.PrimaryDarkColor; --tenant-accent: @Model.Theme.AccentColor; --tenant-surface: @Model.Theme.SurfaceColor; --tenant-text: @Model.Theme.TextColor; --tenant-heading-font: @Model.Theme.HeadingFontFamily; --tenant-body-font: @Model.Theme.BodyFontFamily; }</style>
}
@section scripts { <abp-script src="/Pages/BillApproval.js" /> }

<main class="approval-page" data-initial-step="@Model.InitialStep">
    <header class="approval-hero">
        <div>
            <span class="eyebrow">Registration checkout</span>
            <h1>Review and approve your bill</h1>
            <p>Confirm your classes, funding@(Model.RemainingBalance > 0 ? ", payment choice," : ",") and agreement in one guided review.</p>
        </div>
        <div class="student-chip"><span>@Model.StudentName</span><strong>ID @Model.StudentId</strong></div>
    </header>

    @if (Model.IsUnavailable)
    {
        <section class="notice" role="status"><i class="fa-regular fa-circle-exclamation"></i><div><h2>Your bill review is temporarily unavailable</h2><p>No information has been changed. Please try again shortly.</p></div></section>
    }
    else
    {
        @if (Model.IsAlreadyAccepted)
        {
            <section class="approval-complete" role="status">
                <div class="finish-icon"><i class="fa-solid fa-file-circle-check"></i></div>
                <span class="eyebrow">Approval complete</span>
                <h2>Your bill has been approved</h2>
                @if (Model.PdfAvailable)
                {
                    <p>Your agreement is complete. You can download a copy for your records.</p>
                    <a class="primary document-download" asp-page-handler="Pdf" asp-route-term="@Model.TermCode"><i class="fa-solid fa-download"></i> Download your agreement</a>
                }
                else
                {
                    <p>Your agreement is complete. Your downloadable copy is being prepared.</p>
                }
            </section>
        }
        else
        {
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <section class="notice success" role="status"><i class="fa-regular fa-circle-check"></i><div><h2>Bill approval status</h2><p>@Model.StatusMessage</p></div></section>
        }
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <nav class="stepper @(Model.RemainingBalance <= 0 ? "no-payment" : null)" aria-label="Bill approval progress">
            <button class="active" type="button" data-step-target="review"><b>1</b><span>Review bill</span></button>
            @if (Model.RemainingBalance > 0)
            {
                <button type="button" data-step-target="payment"><b>2</b><span>Payment choice</span></button>
            }
            <button type="button" data-step-target="agreement"><b>@(Model.RemainingBalance > 0 ? 3 : 2)</b><span>Agreement</span></button>
            <button type="button" data-step-target="finish"><b>@(Model.RemainingBalance > 0 ? 4 : 3)</b><span>Finish</span></button>
        </nav>

        <section class="term-banner"><div><span>Selected term</span><h2>@Model.TermName</h2>@if(Model.AvailableTerms.Count>1){<nav class="bill-term-switcher" aria-label="Open Bill Approval terms">@foreach(var openTerm in Model.AvailableTerms){<a asp-page="/BillApproval" asp-route-term="@openTerm.TermCode" class="@(openTerm.TermCode==Model.TermCode?"active":"")">@openTerm.TermName</a>}</nav>}</div><div><span>Registration</span><strong>@BillApprovalModel.Credits(Model.TotalCredits) credits · @Model.Courses.Count classes</strong></div></section>

        <div class="approval-layout">
            <div class="approval-main">
                <section class="approval-step active" data-step="review">
                    <div class="section-title"><div><span>Step 1</span><h2>Review your semester</h2></div><p>@(Model.RemainingBalance > 0 ? "Verify these details before choosing how to cover the balance." : "Verify these details before reviewing your agreement.")</p></div>
                    <details open><summary><span><i class="fa-solid fa-calendar-days"></i>Class schedule</span><strong>@BillApprovalModel.Credits(Model.TotalCredits) credits</strong></summary>
                        <div class="review-list">@foreach (var course in Model.Courses) { <article><div><strong>@course.Department @course.CourseNumber-@course.Section</strong><span>@course.CourseName</span></div><b>@BillApprovalModel.Credits(course.Credits) cr</b></article> }</div>
                    </details>
                    <details open><summary><span><i class="fa-solid fa-receipt"></i>Charges and credits</span><strong>@BillApprovalModel.Currency(Model.AccountBalance)</strong></summary>
                        <div class="review-list">@foreach (var item in Model.Charges.Where(x => !x.IsVoided)) { <article><div><strong>@item.Description</strong><span>@item.TransactionDate.ToString("MMM d, yyyy") @if(item.IsPending){<em>Pending</em>}</span></div><b>@BillApprovalModel.Currency(item.BalanceChange)</b></article> }</div>
                    </details>
                    <details open><summary><span><i class="fa-solid fa-graduation-cap"></i>Expected financial aid</span><strong>-@BillApprovalModel.Currency(Model.PendingAidTotal)</strong></summary>
                        <div class="review-list">@foreach (var award in Model.Aid.Where(x => x.Amount > 0 && !x.IsSentToBilling && x.StudentAccepted != 0 && !x.AwardStatus.Contains("Cancel", StringComparison.OrdinalIgnoreCase))) { <article><div><strong>@award.Description</strong><span>@award.AwardStatus · Anticipated</span></div><b>-@BillApprovalModel.Currency(award.Amount)</b></article> }</div>
                    </details>
                    <button class="primary next" type="button" data-next="@(Model.RemainingBalance > 0 ? "payment" : "agreement")">@(Model.RemainingBalance > 0 ? "Continue to payment choice" : "Review agreement") <i class="fa-solid fa-arrow-right"></i></button>
                </section>

                @if (Model.RemainingBalance > 0)
                {
                <section class="approval-step" data-step="payment" hidden>
                    <div class="section-title"><div><span>Step 2</span><h2>Choose how to cover your balance</h2></div><p>Your selection will be recorded with this approval.</p></div>
                    <div class="choice-grid">
                        <label><input type="radio" name="paymentChoice" value="PayNow" checked="@(Model.InitialPaymentChoice == "PayNow")"><span class="choice-icon"><i class="fa-solid fa-credit-card"></i></span><strong>Pay remaining balance</strong><small>Pay @BillApprovalModel.Currency(Math.Max(Model.RemainingBalance, 0)) today.</small></label>
                        <label><input type="radio" name="paymentChoice" value="Deferred" checked="@(Model.InitialPaymentChoice == "Deferred")"><span class="choice-icon"><i class="fa-solid fa-calendar-check"></i></span><strong>Deferred payment plan</strong><small>Split the balance into installments. A $100 enrollment fee applies@(Model.DeferredDueToday > 0 ? $"; {BillApprovalModel.Currency(Model.DeferredDueToday)} is due today" : "; no payment is due today").</small></label>
                    </div>
                    @if (Model.PaymentPlan is not null)
                    {
                        <section class="plan-preview" id="planPreview" hidden="@(Model.InitialPaymentChoice != "Deferred")">
                            <div><span>Your estimated plan</span><strong>@Model.PaymentPlan.Installments.Count payments · $100 fee included</strong></div>
                            <div class="installments">
                                @foreach (var installment in Model.PaymentPlan.Installments)
                                {
                                    <article><b>@(installment.Number == 1 ? "Due today" : $"Payment {installment.Number}")</b><strong>@BillApprovalModel.Currency(installment.Amount)</strong><span>@installment.DueDescription</span></article>
                                }
                            </div>
                        </section>
                    }
                    <form method="post" asp-page-handler="Payment" asp-route-term="@Model.TermCode" id="billPaymentForm" class="bill-payment-form" autocomplete="on"
                          data-pay-now-amount="@BillApprovalModel.Currency(Math.Max(Model.RemainingBalance, 0))"
                          data-deferred-amount="@BillApprovalModel.Currency(Model.DeferredDueToday)"
                          data-deferred-due-today="@(Model.DeferredDueToday > 0 ? "true" : "false")">
                        <input type="hidden" asp-for="PaymentPurposeInput" id="paymentPurposeInput" />
                        <div class="payment-amount"><span id="paymentAmountLabel">Payment amount</span><strong id="paymentAmountValue">@BillApprovalModel.Currency(Model.InitialPaymentChoice == "Deferred" ? Model.DeferredDueToday : Math.Max(Model.RemainingBalance, 0))</strong></div>
                        <div class="card-fields">
                            <label class="full-field">Card number
                                <input asp-for="PaymentCardNumber" inputmode="numeric" autocomplete="cc-number" placeholder="Card number" />
                                <span asp-validation-for="PaymentCardNumber"></span>
                            </label>
                            <label>Expiration month
                                <select asp-for="PaymentExpirationMonth" autocomplete="cc-exp-month">
                                    @for (var month = 1; month <= 12; month++) { <option value="@month">@month.ToString("00")</option> }
                                </select>
                                <span asp-validation-for="PaymentExpirationMonth"></span>
                            </label>
                            <label>Expiration year
                                <select asp-for="PaymentExpirationYear" autocomplete="cc-exp-year">
                                    @for (var year = DateTime.UtcNow.Year; year <= DateTime.UtcNow.Year + 15; year++) { <option value="@year">@year</option> }
                                </select>
                                <span asp-validation-for="PaymentExpirationYear"></span>
                            </label>
                            <label>Security code
                                <input asp-for="PaymentSecurityCode" inputmode="numeric" autocomplete="cc-csc" maxlength="4" placeholder="CVV" />
                                <span asp-validation-for="PaymentSecurityCode"></span>
                            </label>
                            <label>Billing ZIP/postal code
                                <input asp-for="PaymentPostalCode" autocomplete="postal-code" />
                                <span asp-validation-for="PaymentPostalCode"></span>
                            </label>
                        </div>
                        @if (Model.IsPayflowTestMode)
                        {
                            <aside class="payment-test-note"><strong>Payflow test mode</strong><span>No real charges will be made. Use card 4111 1111 1111 1111 with a future expiration date.</span></aside>
                        }
                        <div class="integration-note"><i class="fa-solid fa-shield-halved"></i><span>Your card information is sent securely to PayPal and is never stored by CampusFlow.</span></div>
                        <div class="step-actions">
                            <button class="secondary" type="button" data-next="review">Back</button>
                            <button class="primary" type="submit" id="paymentSubmitButton"><span>Pay @BillApprovalModel.Currency(Math.Max(Model.RemainingBalance, 0)) securely</span> <i class="fa-solid fa-lock"></i></button>
                        </div>
                    </form>
                    <div id="deferredContinue" hidden>
                        <div class="step-actions">
                            <button class="secondary" type="button" data-next="review">Back</button>
                            <button class="primary" type="button" data-next="agreement">Review agreement <i class="fa-solid fa-arrow-right"></i></button>
                        </div>
                    </div>
                </section>
                }

                <section class="approval-step" data-step="agreement" hidden>
                    <div class="section-title"><div><span>Step @(Model.RemainingBalance > 0 ? 3 : 2)</span><h2>Terms and conditions</h2></div><p>A copy of this exact agreement will be preserved with your approval.</p></div>
                    <div class="agreement-copy">
                        @if (Model.Agreement is null)
                        {
                            <p class="agreement-placeholder">No published agreement is currently available. An administrator must publish one before approval can be completed.</p>
                        }
                        else
                        {
                            @Html.Raw(Model.Agreement.ContentHtml)
                            <p class="agreement-version">Agreement version @Model.Agreement.Version</p>
                        }
                    </div>
                    <label class="agree-check"><input type="checkbox" id="agreementAccepted"><span>I have reviewed and agree to the terms and conditions for @Model.TermName.</span></label>
                    <div class="step-actions"><button class="secondary" type="button" data-next="@(Model.RemainingBalance > 0 ? "payment" : "review")">Back</button><button class="primary" type="button" data-next="finish" disabled id="agreementContinue">Continue <i class="fa-solid fa-arrow-right"></i></button></div>
                </section>

                <section class="approval-step" data-step="finish" hidden>
                    <div class="finish-icon"><i class="fa-solid fa-file-circle-check"></i></div><span class="eyebrow">Step @(Model.RemainingBalance > 0 ? 4 : 3)</span><h2>Ready for final approval</h2><p>Your review is complete. Final approval will securely record your agreement and prepare a copy for your records.</p>
                    <form method="post" data-processing-form>
                        <input type="hidden" asp-for="PaymentChoiceInput" id="paymentChoiceInput" value="@(Model.RemainingBalance <= 0 ? "NoBalanceDue" : "PayNow")" />
                        <input type="hidden" asp-for="AgreementAcceptedInput" id="agreementAcceptedInput" value="false" />
                        <button class="primary final-button" type="submit" id="finalApprovalButton" data-has-balance="@(Model.RemainingBalance > 0 ? "true" : "false")" disabled><i class="fa-solid fa-lock"></i> Record agreement</button>
                    </form>
                    <small class="final-help">Please keep this page open while your agreement is recorded.</small>
                    <button class="link-button" type="button" data-next="agreement">Back to agreement</button>
                </section>
            </div>

            <aside class="summary-card">
                <span>Amount to resolve</span><strong>@BillApprovalModel.Currency(Math.Max(Model.RemainingBalance, 0))</strong><p>for @Model.TermName</p>
                <dl><div><dt>Term charges</dt><dd>@BillApprovalModel.Currency(Model.ChargesTotal)</dd></div><div><dt>Payments &amp; credits</dt><dd>-@BillApprovalModel.Currency(Model.CreditsTotal)</dd></div><div><dt>Expected financial aid</dt><dd>-@BillApprovalModel.Currency(Model.PendingAidTotal)</dd></div><div class="total"><dt>Remaining balance</dt><dd>@BillApprovalModel.Currency(Model.RemainingBalance)</dd></div></dl>
                <div class="summary-status"><i class="fa-solid fa-rotate"></i><span><strong>Live account review</strong>Includes posted and pending activity.</span></div>
            </aside>
        </div>
        <div class="processing-modal" id="agreementProcessing" role="dialog" aria-modal="true" aria-labelledby="processingTitle" hidden>
            <div class="processing-card">
                <span class="processing-spinner" aria-hidden="true"></span>
                <h2 id="processingTitle">Recording your agreement</h2>
                <p>Please wait while we securely save your approval and prepare your copy.</p>
            </div>
        </div>
        <div class="processing-modal" id="paymentProcessing" role="dialog" aria-modal="true" aria-labelledby="paymentProcessingTitle" hidden>
            <div class="processing-card">
                <span class="processing-spinner" aria-hidden="true"></span>
                <h2 id="paymentProcessingTitle">Processing your payment</h2>
                <p>Please do not close or refresh this page. Your agreement will be ready for review when payment is complete.</p>
            </div>
        </div>
        }
    }
</main>
