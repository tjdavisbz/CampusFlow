@model CampusFlow.Web.Components.Toolbar.SchedulerView.SchedulerViewToolbarModel
<div class="scheduler-view-banner" role="status">
    <i class="fa-solid fa-eye" aria-hidden="true"></i>
    <span><strong>Viewing as @Model.Name</strong><small>@Model.Email · Read-only</small></span>
    <form method="post" action="/Admin/ImpersonateScheduler/End">
        @Html.AntiForgeryToken()
        <button type="submit">Exit scheduler view</button>
    </form>
</div>
<div class="scheduler-view-readonly-modal" id="schedulerViewReadOnlyModal" hidden role="alertdialog" aria-modal="true" aria-labelledby="schedulerViewReadOnlyTitle">
    <div class="scheduler-view-readonly-card">
        <h2 id="schedulerViewReadOnlyTitle">Changes are disabled</h2>
        <p>Exit scheduler view before performing actions that change information.</p>
        <button type="button" id="schedulerViewReadOnlyAcknowledge">Got it</button>
    </div>
</div>
<style>
    .scheduler-view-banner{max-width:calc(100vw - 20px);position:fixed;z-index:1090;top:58px;right:18px;display:flex;align-items:center;gap:.75rem;padding:.7rem .8rem;border:1px solid #d49b13;border-radius:.8rem;background:#fff4cc;color:#4b3500;box-shadow:0 10px 30px rgba(60,42,0,.2)}
    .scheduler-view-banner>span{min-width:0;overflow-wrap:anywhere;display:flex;flex-direction:column;line-height:1.15}.scheduler-view-banner small{margin-top:.2rem;color:#715b25}.scheduler-view-banner button{border:0;border-radius:.55rem;padding:.55rem .75rem;background:#6a4700;color:#fff;font-weight:750}.scheduler-view-banner form{margin:0}
    .scheduler-view-readonly-modal{position:fixed;z-index:2200;inset:0;display:grid;place-items:center;padding:1rem;background:rgba(18,13,30,.58)}.scheduler-view-readonly-modal[hidden]{display:none}.scheduler-view-readonly-card{box-sizing:border-box;width:min(430px,100%);padding:1.7rem;border-radius:1.1rem;background:#fff;color:#172033;text-align:center}.scheduler-view-readonly-card h2{margin:0 0 .4rem;font-size:1.35rem}.scheduler-view-readonly-card p{margin:0;color:#64748b}.scheduler-view-readonly-card button{margin-top:1.2rem;border:0;border-radius:.6rem;padding:.65rem 1.2rem;background:#58318c;color:#fff;font-weight:750}
    @@media(max-width:720px){.scheduler-view-banner{left:10px;right:10px;top:52px}.scheduler-view-banner>span{flex:1}.scheduler-view-banner button{font-size:.8rem}}
</style>
<script>
    (() => {
        const isEndForm = form => form?.action && new URL(form.action, window.location.href).pathname === '/Admin/ImpersonateScheduler/End';
        const modal = document.getElementById('schedulerViewReadOnlyModal');
        const acknowledge = document.getElementById('schedulerViewReadOnlyAcknowledge');
        const showReadOnlyMessage = () => { modal.hidden = false; acknowledge?.focus(); };
        document.addEventListener('submit', event => {
            const form = event.target;
            if ((form.method || 'get').toLowerCase() !== 'post' || isEndForm(form)) return;
            event.preventDefault();
            event.stopImmediatePropagation();
            showReadOnlyMessage();
        }, true);
        acknowledge?.addEventListener('click', () => { modal.hidden = true; });
    })();
</script>
