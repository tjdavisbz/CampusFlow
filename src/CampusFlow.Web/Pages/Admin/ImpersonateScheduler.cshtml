@page "/Admin/ImpersonateScheduler"
@model CampusFlow.Web.Pages.Admin.ImpersonateSchedulerModel
@using CampusFlow.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = "Impersonate Scheduler";
    PageLayout.Content.BreadCrumb.ShowCurrent = false;
    PageLayout.Content.ShowToolbar = false;
    PageLayout.Content.MenuItemName = CampusFlowMenus.ImpersonateScheduler;
}

@section styles {
    <abp-style src="/Pages/Admin/ImpersonateStudent.css" />
    <style>:root{--tenant-primary:@Model.Theme.PrimaryColor;--tenant-primary-dark:@Model.Theme.PrimaryDarkColor}</style>
}

<main class="impersonation-shell">
    <header class="impersonation-hero">
        <div><span>Admin portal</span><h1>Impersonate scheduler</h1><p>Open a secure, read-only view of the scheduler portal.</p></div>
        <div class="read-only-callout"><i class="fa-solid fa-shield-halved"></i><strong>Read-only</strong><span>No information can be changed in this view.</span></div>
    </header>

    <section class="impersonation-card">
        <div class="card-heading"><span>Scheduler search</span><h2>Find a scheduler</h2><p>Search by name, portal username or email address. Only active, assigned schedulers are listed.</p></div>
        <form method="get" class="student-search">
            <label asp-for="Query" class="visually-hidden">Scheduler search</label>
            <div class="search-control"><i class="fa-solid fa-magnifying-glass"></i><input asp-for="Query" placeholder="Name, username, or email" autocomplete="off" /><button type="submit">Search</button></div>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.SearchError))
        {
            <div class="empty-result"><i class="fa-solid fa-triangle-exclamation"></i><strong>Search unavailable</strong><span>@Model.SearchError</span></div>
        }
        else if (Model.SearchPerformed && Model.Results.Count == 0)
        {
            <div class="empty-result"><i class="fa-regular fa-circle-question"></i><strong>No scheduler found</strong><span>Try a different name, username, or email address.</span></div>
        }
        else if (Model.Results.Count > 0)
        {
            <div class="result-list">
                @foreach (var scheduler in Model.Results)
                {
                    <article class="student-result">
                        <div class="student-avatar">@(string.IsNullOrWhiteSpace(scheduler.DisplayName) ? "S" : scheduler.DisplayName.Substring(0, 1).ToUpperInvariant())</div>
                        <div class="student-details"><strong>@scheduler.DisplayName</strong><span>@scheduler.UserName</span>@if (!string.IsNullOrWhiteSpace(scheduler.Email)){<small>@scheduler.Email</small>}</div>
                        <form method="post" asp-page-handler="Start">
                            <input type="hidden" name="Email" value="@scheduler.Email" />
                            <button type="submit">View as scheduler <i class="fa-solid fa-arrow-right"></i></button>
                        </form>
                    </article>
                }
            </div>
        }
    </section>
</main>
