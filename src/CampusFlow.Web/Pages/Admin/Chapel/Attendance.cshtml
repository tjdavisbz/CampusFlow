@page
@model CampusFlow.Web.Pages.Admin.Chapel.AttendanceModel
@using CampusFlow.Chapel
@using CampusFlow.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = "Chapel Attendance";
    PageLayout.Content.BreadCrumb.ShowCurrent = false;
    PageLayout.Content.ShowToolbar = false;
    PageLayout.Content.MenuItemName = CampusFlowMenus.ChapelAdmin + ".Attendance";
}

@section styles {
    @if (!string.IsNullOrWhiteSpace(Model.Theme.FontStylesheetUrl)) { <link rel="stylesheet" href="@Model.Theme.FontStylesheetUrl" /> }
    <abp-style src="/Pages/ChapelAttendance.css" />
    <abp-style src="/Pages/Admin/Chapel/Attendance.css" />
    <style>:root{--tenant-primary:@Model.Theme.PrimaryColor;--tenant-primary-dark:@Model.Theme.PrimaryDarkColor;--tenant-accent:@Model.Theme.AccentColor;--tenant-surface:@Model.Theme.SurfaceColor;--tenant-text:@Model.Theme.TextColor;--tenant-heading-font:@Model.Theme.HeadingFontFamily;--tenant-body-font:@Model.Theme.BodyFontFamily}</style>
}

@section scripts { <script src="~/Pages/Admin/Chapel/Attendance.js" asp-append-version="true"></script> }
<main id="chapel-attendance-workspace" class="chapel-page chapel-admin-page" data-summary-url="@(Model.SessionSummaries.Count>0 ? Url.Page(null,"DaySummary",new{termId=Model.TermId,date=Model.Date?.ToString("yyyy-MM-dd")}) : "")">
    <header class="chapel-hero"><span>Chapel administration</span><h1>Attendance</h1><p>Find a chapel session, dorm, or student, then update attendance directly in the list.</p></header>
    <p class="chapel-admin-note">Status and comment edits save automatically after you pause typing. Check the save message before leaving. <a asp-page="Dorms" asp-route-termId="@Model.TermId" asp-route-dorm="@Model.Dorm">View dorm roster</a></p>
    @if (!Model.IsUnavailable && ChapelDorms.IsValid(Model.Dorm ?? ""))
    {
        <section class="alert alert-info" aria-label="Selected dorm attendance">
            <strong>@ChapelDorms.Name(Model.Dorm!) attendance@(Model.Date.HasValue ? $" · {Model.Date.Value:MMMM d, yyyy}" : "")</strong>
            <p class="mb-0">@(Model.Date.HasValue ? "Edit students’ statuses and comments below. Your changes save automatically while this filter stays selected." : "Choose a chapel date below to edit this dorm’s attendance for that day.")</p>
        </section>
    }
    <p id="chapel-save-summary" class="chapel-admin-note" role="status" aria-live="polite"></p>
    <noscript><p class="alert alert-info">Automatic saving requires JavaScript. Use Save change for each edited record.</p></noscript>
    @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert alert-success" role="status">@Model.Message</div> }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
    @if (Model.IsUnavailable) { <section class="chapel-message" role="status"><i class="fa-regular fa-circle-exclamation" aria-hidden="true"></i><div><h2>Attendance is temporarily unavailable</h2><p>Please try again later.</p></div></section> }
    else
    {
        <section class="chapel-panel" aria-labelledby="chapel-search-heading">
        <div class="chapel-toolbar"><div><span>Find records</span><h2 id="chapel-search-heading">Search attendance</h2></div></div>
        <form method="get" class="chapel-admin-filters">
            <div><label for="termId">Academic term</label>
                <select id="termId" name="termId" required>
                    @foreach (var term in Model.Terms)
                    {
                        <option value="@term.ExternalTermId" selected="@(term.ExternalTermId == Model.TermId?.ToString())">@term.DisplayName</option>
                    }
                </select>
            </div>
            <div><label for="date">Chapel date</label><input id="date" name="date" type="date" value="@Model.Date?.ToString("yyyy-MM-dd")" /><small>Combine a date and dorm to edit that dorm’s students for the day.</small></div>
            <div><label for="student">Student ID or name</label><input id="student" name="student" value="@Model.Student" maxlength="100" placeholder="First and last name, or part of either" /><small>Middle names are optional; partial names work.</small></div>
            <div><label for="group">Group</label><select id="group" name="group"><option value="">All groups</option>
                @foreach (var group in Model.Groups) { <option value="@group" selected="@(group == Model.Group)">@group</option> }
            </select></div>
            <div><label for="dorm">Filter by dorm</label><select id="dorm" name="dorm"><option value="">All housing</option>
                @foreach(var dorm in ChapelDorms.Options){<option value="@dorm.Key" selected="@(dorm.Key==Model.Dorm)">@dorm.Name</option>}
            </select><small>Edit the filtered records below without opening students individually.</small></div>
            <div class="chapel-scan-filter"><label for="showScanInOnly"><input id="showScanInOnly" name="showScanInOnly" type="checkbox" value="true" checked="@Model.ShowScanInOnly" /> Scan-in-only absences</label></div>
            <button type="submit">Search attendance</button>
        </form>
        </section>
        @if (Model.Date.HasValue || !string.IsNullOrWhiteSpace(Model.Student) || !string.IsNullOrWhiteSpace(Model.Group) || !string.IsNullOrWhiteSpace(Model.Dorm))
        {
            @if (Model.SessionSummaries.Count > 0)
            {
                <section class="chapel-panel chapel-session-review" aria-labelledby="chapel-day-heading">
                    <div class="chapel-toolbar"><div><span>Day review</span><h2 id="chapel-day-heading">@Model.Date?.ToString("MMMM d, yyyy")</h2></div></div>
                    <p class="chapel-admin-note">Each chapel session is separate. The correction below credits only imported absences labeled “Scan In Only”; it does not change other absences, excuses, or staff decisions.</p>
                    <p id="chapel-totals-message" class="chapel-admin-note" role="status"></p>
                    <div class="chapel-session-list">
                    @foreach (var session in Model.SessionSummaries)
                    {
                        var confirmation = $"Credit all {session.ScanInOnly} scan-in-only absences for the {session.ChapelAtLocal:h:mm tt} chapel as Present? Use this only if scan-out was waived for this session. This cannot be undone as a group.";
                        <div class="chapel-session-card" data-session="@session.ChapelAtLocal.ToString("yyyy-MM-ddTHH:mm:ss")">
                            <div><strong>@session.ChapelAtLocal.ToString("h:mm tt") chapel</strong><span data-session-counts>@session.Total students · @session.Present present · @session.Absent absent · @session.Excused excused · @session.ScanInOnly scan-in-only</span></div>
                            @if (session.ScanInOnly > 0)
                            {
                                <form method="post" asp-page-handler="CreditScanInOnly" data-bulk-credit data-confirmation="@confirmation" onsubmit="return confirm(this.dataset.confirmation);">
                                    <input type="hidden" name="termId" value="@Model.TermId" />
                                    <input type="hidden" name="sessionAtLocal" value="@session.ChapelAtLocal.ToString("yyyy-MM-ddTHH:mm:ss")" />
                                    <input type="hidden" name="expectedCount" value="@session.ScanInOnly" />
                                    <button type="submit">Credit @session.ScanInOnly scan-in-only records</button>
                                </form>
                            }
                        </div>
                    }
                    </div>
                </section>
            }
            <section class="chapel-panel" aria-labelledby="chapel-results-heading">
            <div class="chapel-toolbar"><div><span>Attendance records</span><h2 id="chapel-results-heading">@(Model.ShowScanInOnly && Model.Date.HasValue ? "Scan-in-only absences" : "Search results")</h2></div><p class="chapel-admin-count">@Model.Rows.Count result(s)@(Model.IsTruncated ? $" · Showing first {Model.ResultLimit}; narrow your search" : "")</p></div>
            @if (Model.Rows.Count == 0) { <div class="chapel-empty"><h3>No matching records</h3><p>Try another date, student, or group.</p></div> }
            else { <div class="chapel-table-wrap"><table class="chapel-table chapel-admin-table">
                <thead><tr><!th scope="col">Student</!th><!th scope="col">Chapel</!th><!th scope="col">Status and comment</!th><!th scope="col">Source</!th><!th scope="col">Action</!th></tr></thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    var formId = "chapel-" + row.Id.ToString("N");
                    <tr data-attendance-row>
                        <td data-label="Student"><strong>@row.StudentName</strong><span class="chapel-time">@row.StudentId</span></td>
                        <td data-label="Chapel session">@row.ChapelAtLocal.ToString("MMM d, yyyy h:mm tt")</td>
                        <td data-label="Attendance decision"><span data-attendance-status class="chapel-status @row.Status.ToString().ToLowerInvariant()">@row.Status</span><label for="status-@formId">Change status</label>
                            <select id="status-@formId" name="status" form="@formId">
                                @foreach (var value in Enum.GetValues<ChapelAttendanceStatus>())
                                {
                                    <option value="@value" selected="@(row.Status == value)">@value</option>
                                }
                            </select>
                            <label for="comment-@formId">Comment</label>
                            <input id="comment-@formId" name="comment" form="@formId" value="@row.Comment" maxlength="4000" placeholder="Optional note" />
                        </td>
                        <td data-label="Source" data-attendance-source>@row.Source</td>
                        <td data-label="Action"><form id="@formId" method="post" asp-page-handler="Update" data-chapel-autosave>
                            <input type="hidden" name="id" value="@row.Id" />
                            <input type="hidden" name="revision" value="@row.Revision" />
                            <input type="hidden" name="termId" value="@Model.TermId" />
                            <input type="hidden" name="date" value="@Model.Date?.ToString("yyyy-MM-dd")" />
                            <input type="hidden" name="student" value="@Model.Student" />
                            <input type="hidden" name="group" value="@Model.Group" />
                            <input type="hidden" name="dorm" value="@Model.Dorm" />
                            <input type="hidden" name="showScanInOnly" value="@Model.ShowScanInOnly.ToString().ToLowerInvariant()" />
                            <span data-save-message role="status" aria-live="polite">Up to date</span>
                            <button type="submit" data-save-now>Save change</button>
                            <button type="button" data-reload-record hidden>Reload saved record</button>
                        </form></td>
                    </tr>
                }
                </tbody>
            </table></div> }
            <p class="chapel-admin-note">Staff changes are retained separately from imported scans.</p>
            </section>
        }
        else { <section class="chapel-panel chapel-empty" role="status"><h2>Ready to search</h2><p>Choose a chapel date, student, or group above to see attendance records.</p></section> }
    }
</main>
