@page "/Admin/CourseSelection"
@model CampusFlow.Web.Pages.Admin.RegistrationRulesModel
@using CampusFlow.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@{ PageLayout.Content.Title="Course Selection"; PageLayout.Content.MenuItemName=CampusFlowMenus.RegistrationRules; }
@section styles {
 <abp-style src="/Pages/Admin/AdminConfiguration.css" />
 <style>:root{--tenant-primary:@Model.Theme.PrimaryColor;--tenant-primary-dark:@Model.Theme.PrimaryDarkColor;--tenant-accent:@Model.Theme.AccentColor}</style>
}
<main class="admin-config-shell">
 <header class="admin-config-hero"><div><span>Admin portal</span><h1>Course selection</h1><p>Choose which terms are open for course selection and tailor the rules students use for each.</p></div><i class="fa-solid fa-calendar-check"></i></header>
 <section class="config-card term-list-card">
  <div class="section-heading"><span>Course selection calendar</span><h2>Configured terms</h2><p>Students can switch between every enabled term whose course-selection window is currently open.</p></div>
  @if(Model.Configurations.Count==0){<div class="empty-result"><strong>No terms configured yet</strong><span>Configure a term below before students can begin Course Selection.</span></div>}
  else {<div class="config-table"><div class="config-table-head"><span>Term</span><span>Course-selection window</span><span>Status</span><span>Actions</span></div>
   @foreach(var item in Model.Configurations){var open=item.IsOpen(DateTime.Now);var studentCount=item.GetStudentAccessIds().Count;var groupCount=item.GetGroupWindows().Count;<div class="config-table-row"><div><strong>@item.TermName</strong></div><div><span>@item.RegistrationOpensAt.ToString("MMM d, yyyy h:mm tt")</span><small>through @item.RegistrationClosesAt.ToString("MMM d, yyyy h:mm tt")</small></div><div><span class="status-pill @(open?"active":"")">@(open?"Open":item.IsEnabled?"Scheduled / group access":"Disabled")</span>@if(studentCount>0){<small>@studentCount student-specific access @(studentCount==1?"entry":"entries")</small>}@if(groupCount>0){<small>@groupCount group @(groupCount==1?"window":"windows")</small>}</div><div class="row-actions"><a asp-route-edit="@item.Id" asp-fragment="term-editor">Edit</a><a asp-route-copyFrom="@item.Id" asp-fragment="term-editor"><i class="fa-regular fa-copy"></i> Copy forward</a></div></div>}
  </div>}
 </section>
 <form method="post" asp-page-handler="Save" class="config-card term-editor" id="term-editor">
  <input asp-for="Input.Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
  <div class="section-heading"><span>@(Model.Input.Id.HasValue?"Edit term":"New term")</span><h2>@(Model.Input.Id.HasValue?"Update course-selection settings":"Configure course selection for a term")</h2><p>Use Copy forward above to start a future term with the same attendance mappings and rules.</p></div>
  <div class="field-grid">
   <label class="wide">
    <span>Academic term</span>
    @if (Model.Input.Id.HasValue)
    {
        <input asp-for="Input.ExternalTermId" type="hidden" />
        <div class="term-display"><i class="fa-regular fa-calendar"></i><strong>@Model.Terms.FirstOrDefault(x => x.Value == Model.Input.ExternalTermId)?.Text</strong><span>Current configuration</span></div>
        <small>To use these rules for another term, choose Copy forward above.</small>
    }
    else
    {
        <div class="term-picker" data-term-picker>
            <input asp-for="Input.ExternalTermId" type="hidden" data-term-value />
            <button type="button" class="term-picker-trigger" aria-haspopup="listbox" aria-expanded="false">
                <span><i class="fa-regular fa-calendar"></i><strong data-term-label>@(Model.Terms.FirstOrDefault(x => x.Value == Model.Input.ExternalTermId)?.Text ?? "Choose a term…")</strong></span>
                <i class="fa-solid fa-chevron-down picker-chevron"></i>
            </button>
            <div class="term-picker-menu" role="listbox" hidden>
                @foreach (var term in Model.Terms)
                {
                    <button type="button" role="option" data-value="@term.Value" aria-selected="@(term.Value == Model.Input.ExternalTermId ? "true" : "false")"><i class="fa-regular fa-calendar-check"></i><span>@term.Text</span><i class="fa-solid fa-check selected-check"></i></button>
                }
            </div>
        </div>
    }
    <span asp-validation-for="Input.ExternalTermId"></span>
   </label>
   <label>Course selection opens<input asp-for="Input.RegistrationOpensAt" type="datetime-local" /></label>
   <label>Course selection closes<input asp-for="Input.RegistrationClosesAt" type="datetime-local" /><span asp-validation-for="Input.RegistrationClosesAt"></span></label>
  </div>
  <div class="toggle-grid"><label><input asp-for="Input.IsEnabled" /><span><strong>Enabled</strong>Allow access to this term.</span></label><label><input asp-for="Input.AllowAllStudentsDuringWindow" /><span><strong>All eligible students during the main window</strong>Turn off when only selected groups or Student IDs should have access.</span></label><label><input asp-for="Input.RequireAdvisorReview" /><span><strong>Advisor review</strong>Send new selections to the advisor queue.</span></label><label><input asp-for="Input.EnforceSectionCapacity" /><span><strong>Section capacity</strong>Prevent selection of full sections.</span></label></div>
  <div class="mapping-editor">
   <div class="mapping-heading"><div><strong>Group access windows</strong><small>For each window, select one or more college levels and attendance types. A student must match one value in both lists.</small></div><button type="button" id="addGroupWindow"><i class="fa-solid fa-plus"></i> Add group window</button></div>
   <div id="groupWindowRows">
    @for(var i=0;i<Model.Input.GroupWindows.Count;i++)
    {
     <div class="group-window-row" data-group-window>
      <label>Opens<input asp-for="Input.GroupWindows[i].OpensAt" type="datetime-local" /></label>
      <label>Closes<input asp-for="Input.GroupWindows[i].ClosesAt" type="datetime-local" /></label>
      <label>College levels<select asp-for="Input.GroupWindows[i].CollegeLevels" multiple size="5">@foreach(var value in Model.CollegeLevels){<option value="@value">@value</option>}</select></label>
      <label>Attendance types<select asp-for="Input.GroupWindows[i].AttendanceTypes" multiple size="5">@foreach(var value in Model.StudentAttendanceTypes){<option value="@value">@value</option>}</select></label>
      <button type="button" class="remove-group-window" aria-label="Remove group window"><i class="fa-solid fa-xmark"></i> Remove</button>
     </div>
    }
   </div>
   <span asp-validation-for="Input.GroupWindows"></span>
   <template id="groupWindowTemplate"><div class="group-window-row" data-group-window>
    <label>Opens<input name="Input.GroupWindows[__index__].OpensAt" type="datetime-local" required /></label>
    <label>Closes<input name="Input.GroupWindows[__index__].ClosesAt" type="datetime-local" required /></label>
    <label>College levels<select name="Input.GroupWindows[__index__].CollegeLevels" multiple size="5" required>@foreach(var value in Model.CollegeLevels){<option value="@value">@value</option>}</select></label>
    <label>Attendance types<select name="Input.GroupWindows[__index__].AttendanceTypes" multiple size="5" required>@foreach(var value in Model.StudentAttendanceTypes){<option value="@value">@value</option>}</select></label>
    <button type="button" class="remove-group-window" aria-label="Remove group window"><i class="fa-solid fa-xmark"></i> Remove</button>
   </div></template>
  </div>
  <div class="student-access-editor">
   <label class="block-field" asp-for="Input.StudentIdsText"><span>Open for specific students</span><small>Enter Student IDs, one per line (or separated by commas). These students can select courses for this term outside the general date window. The term must remain Enabled, and all normal course and student eligibility rules still apply. Clearing the list removes this access.</small><textarea asp-for="Input.StudentIdsText" rows="5" placeholder="20000041293"></textarea><span asp-validation-for="Input.StudentIdsText"></span></label>
  </div>
  <div class="mapping-editor"><div class="mapping-heading"><div><strong>Attendance mappings</strong><small>Choose which offered-course attendance type each student group can use.</small></div><button type="button" id="addMapping"><i class="fa-solid fa-plus"></i> Add row</button></div><div id="mappingRows">
   @for(var i=0;i<Model.Input.Mappings.Count;i++){<div class="mapping-row"><select asp-for="Input.Mappings[i].StudentAttendanceType"><option value="">Student attendance type…</option>@foreach(var type in Model.StudentAttendanceTypes){<option value="@type">@type</option>}</select><i class="fa-solid fa-arrow-right"></i><select asp-for="Input.Mappings[i].CourseAttendanceType"><option value="">Course attendance type…</option>@foreach(var type in Model.AttendanceTypes){<option value="@type">@type</option>}</select><button type="button" class="remove-mapping" aria-label="Remove mapping"><i class="fa-solid fa-xmark"></i></button></div>}
  </div><span asp-validation-for="Input.Mappings"></span></div>
  <div class="mapping-editor">
   <div class="mapping-heading"><div><strong>Visible section codes by student attendance type</strong><small>For this term, limit each group to the exact Elements section codes entered below. Use the codes for the intended Main, Session 1, Session 2 or delivery mode; session names do not map automatically. Codes are additional restrictions: existing attendance rules, dates, capacity and student eligibility still apply. A group with no row keeps its current section access. Changes affect new selections, not existing enrollments.</small></div><button type="button" id="addSectionVisibility">Add group</button></div>
   <div id="sectionVisibilityRows">
    @for(var i=0;i<Model.Input.SectionVisibility.Count;i++){
     <div class="section-visibility-row"><label>Student attendance type<select asp-for="Input.SectionVisibility[i].StudentAttendanceType"><option value="">Choose…</option>@foreach(var type in Model.StudentAttendanceTypes){<option value="@type">@type</option>}</select></label><label>Allowed section codes<input asp-for="Input.SectionVisibility[i].SectionCodes" placeholder="100, 101, 102" required /></label><button type="button" data-remove-section-rule>Remove</button></div>
    }
   </div><span asp-validation-for="Input.SectionVisibility"></span>
   <template id="sectionVisibilityTemplate"><div class="section-visibility-row"><label>Student attendance type<select name="Input.SectionVisibility[__index__].StudentAttendanceType" required><option value="">Choose…</option>@foreach(var type in Model.StudentAttendanceTypes){<option value="@type">@type</option>}</select></label><label>Allowed section codes<input name="Input.SectionVisibility[__index__].SectionCodes" placeholder="100, 101, 102" required /></label><button type="button" data-remove-section-rule>Remove</button></div></template>
  </div>
  <button class="primary-action" type="submit"><i class="fa-solid fa-floppy-disk"></i> Save course-selection settings</button>
 </form>
</main>
@section scripts {<script>
document.addEventListener('DOMContentLoaded',()=>{
 const rows=document.getElementById('mappingRows'),add=document.getElementById('addMapping'),form=rows.closest('form');
 const studentTypes=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StudentAttendanceTypes));
 const types=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AttendanceTypes));
 function reindex(){[...rows.children].forEach((row,i)=>{row.querySelectorAll('select')[0].name=`Input.Mappings[${i}].StudentAttendanceType`;row.querySelectorAll('select')[1].name=`Input.Mappings[${i}].CourseAttendanceType`})}
 function wire(){rows.querySelectorAll('.remove-mapping').forEach(b=>b.onclick=()=>{b.closest('.mapping-row').remove();reindex()})}
 add.onclick=()=>{const row=document.createElement('div');row.className='mapping-row';for(const choices of [studentTypes,types]){const select=document.createElement('select');select.add(new Option('Choose…',''));choices.forEach(value=>select.add(new Option(value,value)));row.append(select);if(row.children.length===1){const icon=document.createElement('i');icon.className='fa-solid fa-arrow-right';row.append(icon);}}const button=document.createElement('button');button.type='button';button.className='remove-mapping';button.textContent='Remove';row.append(button);rows.append(row);reindex();wire()};
 form.addEventListener('submit',reindex);wire();reindex();
 const sectionRows=document.getElementById('sectionVisibilityRows');
 const reindexSections=()=>[...sectionRows.children].forEach((row,i)=>row.querySelectorAll('[name]').forEach(field=>{field.name=field.name.replace(/Input\.SectionVisibility\[(?:\d+|__index__)\]/,`Input.SectionVisibility[${i}]`)}));
 document.getElementById('addSectionVisibility').addEventListener('click',()=>{sectionRows.append(document.getElementById('sectionVisibilityTemplate').content.cloneNode(true));reindexSections();});
 sectionRows.addEventListener('click',event=>{const button=event.target.closest('[data-remove-section-rule]');if(button){button.closest('.section-visibility-row').remove();reindexSections();}});
 form.addEventListener('submit',reindexSections);
 const groupRows=document.getElementById('groupWindowRows'),groupTemplate=document.getElementById('groupWindowTemplate');
 const reindexGroups=()=>{[...groupRows.children].forEach((row,i)=>row.querySelectorAll('[name]').forEach(field=>{field.name=field.name.replace(/Input\.GroupWindows\[(?:\d+|__index__)\]/,`Input.GroupWindows[${i}]`)}))};
 groupRows.addEventListener('click',event=>{const remove=event.target.closest('.remove-group-window');if(remove){remove.closest('[data-group-window]').remove();reindexGroups()}});
 document.getElementById('addGroupWindow').addEventListener('click',()=>{groupRows.appendChild(groupTemplate.content.cloneNode(true));reindexGroups()});
 form.addEventListener('submit',reindexGroups);
 document.querySelectorAll('[data-term-picker]').forEach(picker=>{const trigger=picker.querySelector('.term-picker-trigger'),menu=picker.querySelector('.term-picker-menu'),value=picker.querySelector('[data-term-value]'),label=picker.querySelector('[data-term-label]');
  const close=()=>{menu.hidden=true;trigger.setAttribute('aria-expanded','false')};
  trigger.addEventListener('click',()=>{const opening=menu.hidden;menu.hidden=!opening;trigger.setAttribute('aria-expanded',opening?'true':'false')});
  menu.querySelectorAll('[data-value]').forEach(option=>option.addEventListener('click',()=>{value.value=option.dataset.value;label.textContent=option.querySelector('span').textContent;menu.querySelectorAll('[role=option]').forEach(x=>x.setAttribute('aria-selected',x===option?'true':'false'));value.dispatchEvent(new Event('change',{bubbles:true}));close()}));
  document.addEventListener('click',event=>{if(!picker.contains(event.target))close()});
  picker.addEventListener('keydown',event=>{if(event.key==='Escape')close()});
 });
})
</script>}
