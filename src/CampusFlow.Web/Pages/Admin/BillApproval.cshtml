@page "/Admin/BillApproval"
@model CampusFlow.Web.Pages.Admin.BillApprovalModel
@using CampusFlow.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@{ PageLayout.Content.Title="Bill Approval"; PageLayout.Content.MenuItemName=CampusFlowMenus.BillApprovalConfiguration; }
@section styles {<abp-style src="/Pages/Admin/AdminConfiguration.css" /><style>:root{--tenant-primary:@Model.Theme.PrimaryColor;--tenant-primary-dark:@Model.Theme.PrimaryDarkColor;--tenant-accent:@Model.Theme.AccentColor}</style>}
<main class="admin-config-shell">
 <header class="admin-config-hero"><div><span>Admin portal</span><h1>Bill Approval</h1><p>Choose when each term is available and which agreement and payment-plan rules students use.</p></div><i class="fa-solid fa-file-signature"></i></header>
 <section class="config-card term-list-card"><div class="section-heading"><span>Bill Approval calendar</span><h2>Configured terms</h2><p>Disabled drafts are safe to prepare before students can access them.</p></div>
  @if(Model.Configurations.Count==0){<div class="empty-result"><strong>No terms configured yet</strong><span>Configure Bill Approval for the first term below.</span></div>}
  else{<div class="config-table"><div class="config-table-head"><span>Term</span><span>Bill Approval window</span><span>Status</span><span>Actions</span></div>@foreach(var item in Model.Configurations){var open=item.IsOpen(DateTime.Now);<div class="config-table-row"><div><strong>@item.TermName</strong></div><div><span>@item.OpensAt.ToString("MMM d, yyyy h:mm tt")</span><small>through @item.ClosesAt.ToString("MMM d, yyyy h:mm tt")</small></div><div><span class="status-pill @(open?"active":"")">@(open?"Open":item.IsEnabled?"Scheduled / closed":"Disabled")</span></div><div class="row-actions"><a asp-route-edit="@item.Id" asp-fragment="bill-editor">Edit</a><a asp-route-copyFrom="@item.Id" asp-fragment="bill-editor"><i class="fa-regular fa-copy"></i> Copy forward</a></div></div>}</div>}
 </section>
 <form method="post" asp-page-handler="Save" class="config-card term-editor" id="bill-editor">
  <input asp-for="Input.Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
  <div class="section-heading"><span>@(Model.Input.Id.HasValue?"Edit term":"New term")</span><h2>@(Model.Input.Id.HasValue?"Update Bill Approval settings":"Configure Bill Approval for a term")</h2><p>Copy forward carries the agreement and payment-plan versions into the next term.</p></div>
  <div class="field-grid">
   <label class="wide"><span>Academic term</span>@if(Model.Input.Id.HasValue){<input asp-for="Input.ExternalTermId" type="hidden" /><div class="term-display"><i class="fa-regular fa-calendar"></i><strong>@Model.Terms.FirstOrDefault(x=>x.Value==Model.Input.ExternalTermId)?.Text</strong><span>Current configuration</span></div>}else{<div class="term-picker" data-picker><input asp-for="Input.ExternalTermId" type="hidden" data-picker-value /><button type="button" class="term-picker-trigger" aria-expanded="false"><span><i class="fa-regular fa-calendar"></i><strong data-picker-label>@(Model.Terms.FirstOrDefault(x=>x.Value==Model.Input.ExternalTermId)?.Text??"Choose a term…")</strong></span><i class="fa-solid fa-chevron-down picker-chevron"></i></button><div class="term-picker-menu" role="listbox" hidden>@foreach(var option in Model.Terms){<button type="button" data-value="@option.Value" aria-selected="@(option.Value==Model.Input.ExternalTermId?"true":"false")"><i class="fa-regular fa-calendar-check"></i><span>@option.Text</span><i class="fa-solid fa-check selected-check"></i></button>}</div></div>}<span asp-validation-for="Input.ExternalTermId"></span></label>
   <label>Bill Approval opens<input asp-for="Input.OpensAt" type="datetime-local" /></label><label>Bill Approval closes<input asp-for="Input.ClosesAt" type="datetime-local" /><span asp-validation-for="Input.ClosesAt"></span></label>
   <label class="wide"><span class="picker-field-heading"><span>Agreement version</span><a asp-page="/Admin/Agreements"><i class="fa-solid fa-pen"></i> Edit agreements</a></span><div class="term-picker" data-picker><input asp-for="Input.AgreementTemplateId" type="hidden" data-picker-value /><button type="button" class="term-picker-trigger" aria-expanded="false"><span><i class="fa-regular fa-file-lines"></i><strong data-picker-label>@(Model.Agreements.FirstOrDefault(x=>x.Value==Model.Input.AgreementTemplateId.ToString())?.Text??"Choose an agreement…")</strong></span><i class="fa-solid fa-chevron-down picker-chevron"></i></button><div class="term-picker-menu" hidden>@foreach(var option in Model.Agreements){<button type="button" data-value="@option.Value" aria-selected="@(option.Value==Model.Input.AgreementTemplateId.ToString()?"true":"false")"><i class="fa-regular fa-file-lines"></i><span>@option.Text</span><i class="fa-solid fa-check selected-check"></i></button>}</div></div><span asp-validation-for="Input.AgreementTemplateId"></span></label>
   <label class="wide"><span class="picker-field-heading"><span>Payment-plan version</span><a asp-page="/Admin/PaymentPlans"><i class="fa-solid fa-pen"></i> Edit payment plans</a></span><div class="term-picker" data-picker><input asp-for="Input.PaymentPlanPolicyId" type="hidden" data-picker-value /><button type="button" class="term-picker-trigger" aria-expanded="false"><span><i class="fa-regular fa-credit-card"></i><strong data-picker-label>@(Model.PaymentPlans.FirstOrDefault(x=>x.Value==Model.Input.PaymentPlanPolicyId.ToString())?.Text??"Choose a payment plan…")</strong></span><i class="fa-solid fa-chevron-down picker-chevron"></i></button><div class="term-picker-menu" hidden>@foreach(var option in Model.PaymentPlans){<button type="button" data-value="@option.Value" aria-selected="@(option.Value==Model.Input.PaymentPlanPolicyId.ToString()?"true":"false")"><i class="fa-regular fa-credit-card"></i><span>@option.Text</span><i class="fa-solid fa-check selected-check"></i></button>}</div></div><span asp-validation-for="Input.PaymentPlanPolicyId"></span></label>
  </div>
  <div class="toggle-grid"><label><input asp-for="Input.IsEnabled" /><span><strong>Enabled</strong>Allow students to use Bill Approval during this window.</span></label></div>
  <button class="primary-action" type="submit"><i class="fa-solid fa-floppy-disk"></i> Save Bill Approval settings</button>
 </form>
</main>
@section scripts{<script>document.addEventListener('DOMContentLoaded',()=>{document.querySelectorAll('[data-picker]').forEach(picker=>{const trigger=picker.querySelector('.term-picker-trigger'),menu=picker.querySelector('.term-picker-menu'),value=picker.querySelector('[data-picker-value]'),label=picker.querySelector('[data-picker-label]');const close=()=>{menu.hidden=true;trigger.setAttribute('aria-expanded','false')};trigger.onclick=()=>{const open=menu.hidden;menu.hidden=!open;trigger.setAttribute('aria-expanded',open?'true':'false')};menu.querySelectorAll('[data-value]').forEach(option=>option.onclick=()=>{value.value=option.dataset.value;label.textContent=option.querySelector('span').textContent;menu.querySelectorAll('[data-value]').forEach(x=>x.setAttribute('aria-selected',x===option?'true':'false'));close()});document.addEventListener('click',e=>{if(!picker.contains(e.target))close()})})})</script>}
