@model CampusFlow.Web.Pages.IndexModel
@using CampusFlow.Web.Announcements
        <section class="dashboard-announcements" aria-labelledby="announcements-heading">
            <div class="dashboard-announcements-heading"><span class="summary-label">Campus news</span><h2 id="announcements-heading">Announcements</h2></div>
            @if (Model.AnnouncementTerms.Count > 0)
            {
                <p class="dashboard-announcement-terms">Also available for @foreach (var option in Model.AnnouncementTerms){<a asp-page="/Index" asp-route-term="@option.ExternalTermId">@option.DisplayName</a>}</p>
            }
            @foreach (var announcement in Model.VisibleAnnouncements)
            {
                <article class="dashboard-announcement"><h3>@announcement.Title</h3><div>@Html.Raw(AnnouncementHtml.Sanitize(announcement.ContentHtml))</div></article>
            }
        </section>
