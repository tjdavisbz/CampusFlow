@page
@model CampusFlow.Web.Pages.PrivacyPasswordsModel
@using System.Linq
@using CampusFlow.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = "FERPA / Privacy Passwords";
    PageLayout.Content.BreadCrumb.ShowCurrent = false;
    PageLayout.Content.ShowToolbar = false;
    PageLayout.Content.MenuItemName = CampusFlowMenus.PrivacyPasswords;
}

@section styles {
    @if (!string.IsNullOrWhiteSpace(Model.Theme.FontStylesheetUrl)) { <link rel="stylesheet" href="@Model.Theme.FontStylesheetUrl" /> }
    <abp-style src="/Pages/PrivacyPasswords.css" />
    <style>:root{--tenant-primary:@Model.Theme.PrimaryColor;--tenant-primary-dark:@Model.Theme.PrimaryDarkColor;--tenant-accent:@Model.Theme.AccentColor;--tenant-surface:@Model.Theme.SurfaceColor;--tenant-text:@Model.Theme.TextColor;--tenant-heading-font:@Model.Theme.HeadingFontFamily;--tenant-body-font:@Model.Theme.BodyFontFamily}</style>
}

<main class="privacy-page">
    <header class="privacy-hero">
        <span>Student records</span>
        <h1>FERPA / Privacy Passwords</h1>
        <p>View your verification passwords and the people you have listed for Nelson to verify when they contact us about your student information.</p>
        <p class="privacy-hero-note">Changes made here are saved to your Elements student record immediately.</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Feedback))
    {
        <div class="privacy-alert success" role="status">@Model.Feedback</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="privacy-alert error" role="alert">@Model.Error</div>
    }

    @if (Model.IsUnavailable)
    {
        <section class="privacy-panel"><h2>Privacy information is temporarily unavailable</h2><p>Please try again shortly. No changes were made by loading this page.</p></section>
    }
    else
    {
        <section class="privacy-panel" aria-labelledby="existing-heading">
            <div class="privacy-panel-heading"><div><span>Your current entries</span><h2 id="existing-heading">Passwords and authorized people</h2></div><span class="privacy-count">@Model.Entries.Count</span></div>
            @if (Model.Entries.Count == 0)
            {
                <p class="privacy-empty">You do not have any privacy-password entries on file.</p>
            }
            else
            {
                <div class="privacy-entries">
                    @foreach (var entry in Model.Entries)
                    {
                        <article class="privacy-entry">
                            <div class="privacy-entry-copy"><strong>@entry.Label</strong><span>@(entry.IsIndividual ? "Your personal verification password" : entry.HasPassword ? "Authorized person and verification password" : "Existing FERPA record")</span></div>
                            <div class="privacy-entry-actions">
                                <button type="button" class="privacy-button secondary privacy-reveal" data-entry-id="@entry.Id" aria-label="Show @entry.Label">Show</button>
                                @if (entry.HasPassword)
                                {
                                    <form method="post" asp-page-handler="Delete" class="privacy-delete-form">
                                        <input type="hidden" name="id" value="@entry.Id" />
                                        <button type="submit" class="privacy-button danger">Remove</button>
                                    </form>
                                }
                            </div>
                            <div class="privacy-revealed" hidden><span class="privacy-revealed-value"></span><button type="button" class="privacy-hide">Hide</button></div>
                        </article>
                    }
                </div>
            }
            <p class="privacy-note">Passwords are hidden by default. To change one, remove its current entry and add a new one below. Only use this page when no one else can see your screen.</p>
        </section>

        <div class="privacy-forms">
            <section class="privacy-panel" aria-labelledby="personal-heading">
                <span class="privacy-eyebrow">For you</span><h2 id="personal-heading">Individual privacy password</h2>
                <p>Set a personal password you can use when Nelson needs to verify your identity.</p>
                @if (Model.Entries.Any(x => x.IsIndividual))
                {
                    <p class="privacy-existing">You already have an individual privacy password. Remove it above before adding a replacement.</p>
                }
                else
                {
                    <form method="post" asp-page-handler="AddIndividual" autocomplete="off">
                        <label for="individual-password">Privacy password</label>
                        <input id="individual-password" name="password" type="password" required maxlength="50" autocomplete="new-password" />
                        <button type="submit" class="privacy-button primary">Add password</button>
                    </form>
                }
            </section>

            <section class="privacy-panel" aria-labelledby="contact-heading">
                <span class="privacy-eyebrow">For someone you trust</span><h2 id="contact-heading">Add an authorized person</h2>
                <p>List someone Nelson may verify using a password you choose for that person.</p>
                <form method="post" asp-page-handler="AddContact" autocomplete="off">
                    <label for="contact-relationship">Relationship</label>
                    <input id="contact-relationship" name="relationship" type="text" required maxlength="50" placeholder="For example, Parent" />
                    <div class="privacy-name-fields">
                        <div><label for="contact-first-name">First name</label><input id="contact-first-name" name="firstName" type="text" required maxlength="50" /></div>
                        <div><label for="contact-last-name">Last name</label><input id="contact-last-name" name="lastName" type="text" required maxlength="50" /></div>
                    </div>
                    <label for="contact-password">Verification password</label>
                    <input id="contact-password" name="password" type="password" required maxlength="50" autocomplete="new-password" />
                    <button type="submit" class="privacy-button primary">Add authorized person</button>
                </form>
            </section>
        </div>
        <form id="privacy-reveal-token" hidden>@Html.AntiForgeryToken()</form>
        <noscript><p class="privacy-note">Enable JavaScript to reveal an existing password.</p></noscript>
    }
</main>

@section scripts {
    @if (!Model.IsUnavailable)
    {
        <script>window.privacyPasswordsRevealUrl = '@Url.Page("/PrivacyPasswords", "Reveal")';</script>
        <abp-script src="/Pages/PrivacyPasswords.js" />
    }
}
