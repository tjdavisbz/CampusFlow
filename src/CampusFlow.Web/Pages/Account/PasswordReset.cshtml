@page "/Account/PasswordReset"
@model CampusFlow.Web.Pages.Account.PasswordResetModel
@using CampusFlow.AccountRecovery
@{ Layout = null; }
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Forgot password / Activate account | Nelson University</title>
    <link rel="stylesheet" href="~/css/account-recovery.css" asp-append-version="true" />
</head>
<body>
    <a class="recovery-skip" href="#recovery-main">Skip to account recovery</a>
    <main id="recovery-main" class="recovery-shell">
        <header class="recovery-brand">
            <img src="~/images/tenants/nelson/logo-stacked.png" alt="Nelson University" width="248" height="54" />
            <span>Student password</span>
        </header>
        <section class="recovery-card" aria-labelledby="recovery-title">
            <div class="recovery-eyebrow">Account help</div>
            <h1 id="recovery-title">Forgot password /<br /> Activate account</h1>
            @if (Model.Step == RecoveryStep.Unavailable)
            {
                <div class="recovery-status" role="status">
                    <h2>Online account recovery is currently unavailable</h2>
                    <p>Contact Nelson IT for help with account activation or a forgotten password.</p>
                </div>
            }
            else if (Model.Step == RecoveryStep.Unknown)
            {
                <div class="recovery-status" role="status">
                    <h2>We could not confirm the password update</h2>
                    <p>Your password may already have changed. Try signing in with the password you chose, or contact Nelson IT before requesting another reset.</p>
                </div>
            }
            else if (Model.Step == RecoveryStep.Complete)
            {
                <div class="recovery-status recovery-success" role="status">
                    <h2>Your password was updated</h2>
                    <p>Sign in with this password. You will be asked to change it again to finish the reset.</p>
                </div>
            }
            else
            {
                <p class="recovery-intro">Choose a new password for your Nelson student account. First, we need to verify your identity.</p>
                <ol class="recovery-progress" aria-label="Account recovery steps">
                    <li class="@(Model.Step == RecoveryStep.Identity ? "current" : "")" aria-current="@(Model.Step == RecoveryStep.Identity ? "step" : null)">Your details</li>
                    <li class="@(Model.Step == RecoveryStep.Question ? "current" : "")" aria-current="@(Model.Step == RecoveryStep.Question ? "step" : null)">Verify identity</li>
                    <li class="@(Model.Step == RecoveryStep.Password ? "current" : "")" aria-current="@(Model.Step == RecoveryStep.Password ? "step" : null)">New password</li>
                </ol>
                @if (!string.IsNullOrWhiteSpace(Model.Feedback))
                {
                    <p class="recovery-feedback" role="alert">@Model.Feedback</p>
                }
                @if (Model.Step == RecoveryStep.Identity)
                {
                    <form method="post" asp-page-handler="Identity" autocomplete="off">
                        <p id="name-help" class="recovery-help">Use the first and last name on your student record.</p>
                        <div class="recovery-names">
                            <div><label for="recovery-first">First name</label><input id="recovery-first" name="Input.FirstName" type="text" required maxlength="100" autocomplete="off" aria-describedby="name-help" /></div>
                            <div><label for="recovery-last">Last name</label><input id="recovery-last" name="Input.LastName" type="text" required maxlength="100" autocomplete="off" aria-describedby="name-help" /></div>
                        </div>
                        <fieldset class="recovery-ssn">
                            <legend>Social Security number</legend>
                            <p id="ssn-help" class="recovery-help">Enter all nine digits. Your entry is hidden as you type.</p>
                            <div class="recovery-ssn-fields">
                                <div><label for="recovery-ssn-first">First 3 digits</label><input id="recovery-ssn-first" name="Input.SsnFirst" type="password" inputmode="numeric" pattern="[0-9]{3}" minlength="3" maxlength="3" required autocomplete="off" aria-describedby="ssn-help" /></div>
                                <div><label for="recovery-ssn-middle">Middle 2 digits</label><input id="recovery-ssn-middle" name="Input.SsnMiddle" type="password" inputmode="numeric" pattern="[0-9]{2}" minlength="2" maxlength="2" required autocomplete="off" aria-describedby="ssn-help" /></div>
                                <div><label for="recovery-ssn-last">Last 4 digits</label><input id="recovery-ssn-last" name="Input.SsnLast" type="password" inputmode="numeric" pattern="[0-9]{4}" minlength="4" maxlength="4" required autocomplete="off" aria-describedby="ssn-help" /></div>
                            </div>
                        </fieldset>
                        <label for="recovery-birth">Date of birth</label><input id="recovery-birth" name="Input.BirthDate" type="date" required autocomplete="off" />
                        <button type="submit">Continue</button>
                    </form>
                }
                else if (Model.Step == RecoveryStep.Question)
                {
                    <form method="post" asp-page-handler="Answer" autocomplete="off">
                        <p class="recovery-help">Answer the verification question on your student record.</p>
                        <label for="recovery-answer">@Model.Question</label>
                        <input id="recovery-answer" name="Input.Answer" type="password" required maxlength="500" autocomplete="off" />
                        <button type="submit">Verify answer</button>
                    </form>
                }
                else if (Model.Step == RecoveryStep.Password)
                {
                    <form method="post" asp-page-handler="Reset" autocomplete="off">
                        <p id="password-help" class="recovery-help">Use 8–256 characters and choose a password you have not used before. The university also checks password length, complexity, history and how recently your password was changed.</p>
                        <label for="recovery-password">New password</label><input id="recovery-password" name="Input.Password" type="password" required minlength="8" maxlength="256" autocomplete="new-password" aria-describedby="password-help" />
                        <label for="recovery-confirmation">Confirm new password</label><input id="recovery-confirmation" name="Input.Confirmation" type="password" required minlength="8" maxlength="256" autocomplete="new-password" />
                        <p>You will be asked to change this password again the next time you sign in.</p>
                        <button type="submit">Set password</button>
                    </form>
                }
            }
            <footer class="recovery-footer"><a href="/Account/MicrosoftLogin">Return to sign in</a><p>Need help? Contact Nelson IT.</p></footer>
        </section>
        <p class="recovery-privacy">For your privacy, the details you enter are not redisplayed after you continue.</p>
    </main>
</body>
</html>
