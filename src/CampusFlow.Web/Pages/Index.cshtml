@page
@model CampusFlow.Web.Pages.IndexModel
@using CampusFlow.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = Model.HasStudentAccess && !Model.HasAdvisorAccess
        ? "Student Dashboard"
        : Model.HasAdvisorAccess && !Model.HasStudentAccess ? "Advisor Dashboard" : "Dashboard";
    PageLayout.Content.BreadCrumb.ShowCurrent = false;
    PageLayout.Content.ShowToolbar = false;
    PageLayout.Content.MenuItemName = CampusFlowMenus.Home;
}

@section styles {
    @if (!string.IsNullOrWhiteSpace(Model.Theme.FontStylesheetUrl))
    {
        <link rel="stylesheet" href="@Model.Theme.FontStylesheetUrl" />
    }
    <abp-style src="/Pages/Index.css" />
    <style>
        :root {
            --tenant-primary: @Model.Theme.PrimaryColor;
            --tenant-primary-dark: @Model.Theme.PrimaryDarkColor;
            --tenant-accent: @Model.Theme.AccentColor;
            --tenant-neutral: @Model.Theme.NeutralColor;
            --tenant-surface: @Model.Theme.SurfaceColor;
            --tenant-text: @Model.Theme.TextColor;
            --tenant-heading-font: @Model.Theme.HeadingFontFamily;
            --tenant-body-font: @Model.Theme.BodyFontFamily;
        }
    </style>
}

<main class="student-dashboard">
    <section class="dashboard-welcome">
        <div>
            <div class="dashboard-eyebrow">@Model.InstitutionName</div>
            <h1>Welcome, @Model.StudentDisplayName</h1>
            @if (Model.HasAdvisorAccess && !Model.HasStudentAccess)
            {
                <p>Review student course selections and keep registration moving forward.</p>
            }
            else if (Model.HasAdvisorAccess)
            {
                <p>Your student services and advisor responsibilities—all in one place.</p>
            }
            else
            {
                <p>Registration, billing, and the information you need for the semester—all in one place.</p>
            }
        </div>
        <div class="student-identity" aria-label="Student identity">
            @if (Model.HasStudentAccess)
            {
                <span>Student ID</span><strong>@Model.StudentIdentifier</strong>
            }
            else
            {
                <span>Current role</span><strong>Advisor</strong>
            }
        </div>
    </section>

    @if (Model.HasAdvisorAccess)
    {
        <section class="advisor-dashboard-summary" aria-labelledby="advisor-work-heading">
            <div class="advisor-summary-copy"><span class="summary-label">Advisor work</span><h2 id="advisor-work-heading">Course review queue</h2><p>Students remain here until every selected course has a final decision.</p></div>
            <div class="advisor-metric"><strong>@Model.AdvisorStudentCount</strong><span>Students waiting</span></div>
            <div class="advisor-metric"><strong>@Model.AdvisorCourseCount</strong><span>Courses pending</span></div>
            <a href="/Advisor">Open review queue <i class="fa-solid fa-arrow-right"></i></a>
        </section>
    }

    @if (Model.HasStudentAccess)
    {
        <section class="semester-summary" aria-labelledby="semester-heading">
            <div>
                <span class="summary-label">Current term</span>
                <h2 id="semester-heading">@(Model.CurrentTerm?.DisplayName ?? "Term information unavailable")</h2>
            </div>
            @if (Model.CurrentTerm is not null)
            {
                <span class="status-pill status-neutral">
                    @Model.CurrentTerm.StartDate.ToString("MMM d")–@Model.CurrentTerm.EndDate.ToString("MMM d, yyyy")
                </span>
            }
        </section>

        @if (Model.RegistrationJourney is not null)
        {
            <section class="registration-journey" aria-labelledby="registration-journey-heading">
                <div class="journey-heading">
                    <div>
                        <span class="summary-label">Registration checklist</span>
                        <h2 id="registration-journey-heading">Your path to registration</h2>
                        <p>Complete each step to be ready for the semester.</p>
                    </div>
                    <div class="journey-progress" aria-label="@Model.RegistrationJourney.CompletedCount of @Model.RegistrationJourney.Steps.Count steps complete">
                        <strong>@Model.RegistrationJourney.CompletedCount/@Model.RegistrationJourney.Steps.Count</strong>
                        <span>steps complete</span>
                    </div>
                </div>
                <ol class="journey-steps">
                    @foreach (var step in Model.RegistrationJourney.Steps)
                    {
                        <li class="journey-step journey-step-@step.State">
                            <span class="journey-marker" aria-hidden="true">
                                @if (step.State is "complete" or "not-required")
                                {
                                    <i class="fa-solid fa-check"></i>
                                }
                                else if (step.State == "waiting")
                                {
                                    <i class="fa-regular fa-clock"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-arrow-right"></i>
                                }
                            </span>
                            <div class="journey-copy">
                                <h3>@step.Title</h3>
                                <p>@step.Description</p>
                            </div>
                            <a href="@step.Url">@step.ActionLabel <i class="fa-solid fa-chevron-right"></i></a>
                        </li>
                    }
                </ol>
                @if (Model.RegistrationJourney.HasUnavailableData)
                {
                    <p class="journey-note"><i class="fa-solid fa-circle-info"></i> Some status information is still being refreshed. You can continue using the links above.</p>
                }
            </section>
        }

        <section class="portal-actions" aria-label="Student services">
            <article class="portal-card registration-card">
                <div class="portal-card-icon" aria-hidden="true">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div class="portal-card-content">
                    <span class="portal-card-kicker">Plan your semester</span>
                    <h2>Online Registration</h2>
                    <p>Select courses and choose the meal plan available for your attendance type.</p>
                </div>
                <a class="availability-label" href="/CourseSelection">Start registration</a>
            </article>

            <a class="portal-card billing-card" href="/Billing">
                <div class="portal-card-icon" aria-hidden="true">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>
                <div class="portal-card-content">
                    <span class="portal-card-kicker">Complete your clearance</span>
                    <h2>Billing &amp; Payments</h2>
                    <p>Review your schedule, charges, financial aid, balance, and available payment options.</p>
                </div>
                <span class="availability-label">View account</span>
            </a>
        </section>
    }

    <section class="support-card">
        <div class="support-icon" aria-hidden="true"><i class="fa-regular fa-circle-question"></i></div>
        <div>
            <h2>Need help?</h2>
            <p>Support information from your university will appear here.</p>
        </div>
    </section>
</main>
