@page
@model CampusFlow.Web.Pages.ScheduleModel
@using CampusFlow.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = "Schedule";
    PageLayout.Content.BreadCrumb.ShowCurrent = false;
    PageLayout.Content.ShowToolbar = false;
    PageLayout.Content.MenuItemName = CampusFlowMenus.Schedule;
}

@section styles {
    @if (!string.IsNullOrWhiteSpace(Model.Theme.FontStylesheetUrl))
    {
        <link rel="stylesheet" href="@Model.Theme.FontStylesheetUrl" />
    }
    <abp-style src="/Pages/Schedule.css" />
    <style>
        :root {
            --tenant-primary: @Model.Theme.PrimaryColor;
            --tenant-primary-dark: @Model.Theme.PrimaryDarkColor;
            --tenant-accent: @Model.Theme.AccentColor;
            --tenant-surface: @Model.Theme.SurfaceColor;
            --tenant-text: @Model.Theme.TextColor;
            --tenant-heading-font: @Model.Theme.HeadingFontFamily;
            --tenant-body-font: @Model.Theme.BodyFontFamily;
        }
    </style>
}

<main class="schedule-page">
    <header class="schedule-header">
        <div>
            <div class="schedule-eyebrow">Academic plan</div>
            <h1>My Schedule</h1>
            <p>Courses, instructors, meeting details, and credit hours by academic term.</p>
        </div>
        <div class="schedule-student">
            <span>@Model.StudentDisplayName</span>
            <strong>ID @Model.StudentIdentifier</strong>
        </div>
    </header>

    @if (Model.IsScheduleUnavailable)
    {
        <section class="schedule-message" role="status">
            <i class="fa-regular fa-circle-exclamation" aria-hidden="true"></i>
            <div><h2>Schedule information is temporarily unavailable</h2><p>Please try again shortly.</p></div>
        </section>
    }
    else if (Model.CurrentAndUpcomingTerms.Count == 0 && Model.HistoricalTerms.Count == 0)
    {
        <section class="schedule-message">
            <i class="fa-regular fa-calendar" aria-hidden="true"></i>
            <div><h2>No courses to display</h2><p>Your courses will appear here after registration.</p></div>
        </section>
    }
    else
    {
        @if (Model.CurrentAndUpcomingTerms.Count > 0)
        {
            <section class="schedule-section active-schedules" aria-labelledby="active-schedules-heading">
                <div class="schedule-section-heading">
                    <div><span>Now and next</span><h2 id="active-schedules-heading">Current &amp; upcoming schedules</h2></div>
                </div>
                @foreach (var term in Model.CurrentAndUpcomingTerms)
                {
                    @await Html.PartialAsync("_ScheduleTerm", term, new ViewDataDictionary(ViewData)
                    {
                        ["Open"] = term.TermCode == Model.CurrentTermCode,
                        ["ShowStatus"] = true,
                        ["ShowGrades"] = false
                    })
                }
            </section>
        }

        @if (Model.HistoricalTerms.Count > 0)
        {
            <section class="schedule-section" aria-labelledby="past-schedules-heading">
                <div class="schedule-section-heading">
                    <div><span>Academic history</span><h2 id="past-schedules-heading">Earlier schedules</h2></div>
                    <p>Expand a term to review completed coursework.</p>
                </div>
                @foreach (var term in Model.HistoricalTerms)
                {
                    @await Html.PartialAsync("_ScheduleTerm", term, new ViewDataDictionary(ViewData)
                    {
                        ["Open"] = false,
                        ["ShowStatus"] = false,
                        ["ShowGrades"] = true
                    })
                }
            </section>
        }
    }
</main>
