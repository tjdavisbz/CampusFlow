+
+namespace CampusFlow.EntityFrameworkCore.Tests.StudentInformationSystems;
+
+public class ThesisElementsAwardCodeMaintenanceTests
+{
+    [Theory]
+    [InlineData("Yes", true)]
+    [InlineData("No", false)]
