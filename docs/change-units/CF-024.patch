+const fs=require('node:fs'),path=require('node:path'),assert=require('node:assert/strict'),{chromium}=require('playwright');
+const root=path.resolve(__dirname,'../..');
+let markup=fs.readFileSync(path.join(root,'src/CampusFlow.Web/Pages/Admin/Housing/Assignments.cshtml'),'utf8').replace(/@if \(Model.CanApplyToElements\)\s*\{([\s\S]*?)\}\s*else\s*\{[\s\S]*?\}/g,'$1').replace(/@if \(Model.CanApplyToElements\)\s*\{([\s\S]*?)\}/g,'$1').replace('@Html.AntiForgeryToken()','<input name="__RequestVerificationToken" value="test">').replace('@Model.EnvironmentName','NON-PRODUCTION').split('\n').filter(x=>!x.trimStart().startsWith('@')).join('\n');
+const script=fs.readFileSync(path.join(root,'src/CampusFlow.Web/Pages/Admin/Housing/Assignments.js'),'utf8');
+(async()=>{const browser=await chromium.launch({headless:true,executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'});try{
+const page=await browser.newPage(),calls=[],rooms=[{id:1,building:'Kendrick',name:'101',capacity:2,occupants:[{studentUid:1,name:'Student One',rate:'Standard',notes:''}]},{id:2,building:'Savell',name:'201',capacity:2,occupants:[{studentUid:2,name:'Student Two',rate:'Standard',notes:''}]}];let saved;
+await page.route('http://housing.test/**',route=>{const req=route.request();if(req.isNavigationRequest())return route.fulfill({contentType:'text/html',body:markup});const h=new URL(req.url()).searchParams.get('handler');calls.push(h);if(h==='Setup')return route.fulfill({json:{periodId:2,periodName:'Spring 2027',masterCommuterRoomCount:20,periodCommuterRoomCount:20,missingCommuterRooms:[]}});if(h==='Periods')return route.fulfill({json:[{id:2,name:'Spring 2027'}]});if(h==='Draft')return route.fulfill({json:{id:'draft',periodId:2,revision:'same',refreshedAt:'2026-11-09',rooms}});if(h==='Save'){saved=req.postDataJSON();return route.fulfill({json:saved});}throw new Error('Unexpected '+h);});
+await page.goto('http://housing.test/');await page.addScriptTag({content:script});await page.waitForFunction(()=>document.querySelector('#housing-period').options.length===2);await page.selectOption('#housing-period','2');await page.waitForFunction(()=>document.querySelector('#housing-dorm').options.length===3);
+assert.deepEqual(await page.locator('#housing-dorm option').allTextContents(),['All Dorms','Kendrick','Savell']);
+await page.selectOption('#housing-dorm','Kendrick');assert.match(await page.locator('#housing-rows').innerText(),/Student One/);assert.doesNotMatch(await page.locator('#housing-rows').innerText(),/Student Two/);
+await page.check('#housing-select-all');await page.selectOption('#housing-dorm','Savell');assert.equal(await page.locator('#housing-selected-count').innerText(),'No students selected.');
+await page.fill('#housing-filter','Student One');assert.equal(await page.locator('#housing-rows tr').count(),0);await page.fill('#housing-filter','');await page.click('#housing-save');await page.waitForFunction(()=>document.querySelector('#housing-message').textContent.includes('Draft saved'));
+assert.equal(saved.rooms.length,2);assert.equal(saved.rooms.flatMap(x=>x.occupants).length,2);assert.equal(await page.locator('#housing-dorm').inputValue(),'Savell');assert.equal(calls.includes('Refresh'),false);assert.equal(calls.includes('Apply'),false);await page.selectOption('#housing-dorm','');assert.equal(await page.locator('input[aria-label^="Select Student"]').count(),2);console.log('PASS dorm and text filters combine, hidden selections clear, full draft saves, All Dorms restores all students; no Refresh or Apply');
+for(const width of [320,390,768,1440]){const p=await browser.newPage({viewport:{width,height:1000}});const view=fs.readFileSync(path.join(root,'src/CampusFlow.Web/Pages/BillApproval.cshtml'),'utf8');const button=view.match(/<button class="primary final-button"[\s\S]*?<\/button>/)[0].replace(/@\([^)]*\)/g,'false');const css=fs.readFileSync(path.join(root,'src/CampusFlow.Web/Pages/BillApproval.css'),'utf8');await p.route('http://image.test/**',r=>r.fulfill({path:path.join(root,'src/CampusFlow.Web/wwwroot/images/tenants/nelson/judah-celebrating.jpg')}));await p.setContent(`<meta name="viewport" content="width=device-width, initial-scale=1"><style>*{box-sizing:border-box}body{margin:0;--tenant-primary:#502d7f;--tenant-primary-dark:#38205a;--tenant-accent:#ffd987;--tenant-text:#111;--tenant-surface:#f8f8fb;--tenant-body-font:Arial;--tenant-heading-font:Arial}${css}</style><main class="approval-page"><section class="approval-step active" data-step="finish">${button}</section><section class="approval-complete"><h2>Congratulations!</h2><img class="celebrating-lion" src="http://image.test/lion.jpg" alt="Judah celebrating"><p>Your bill has been approved, and your registration is complete!</p></section></main>`);assert.equal(await p.evaluate(()=>document.documentElement.scrollWidth>innerWidth),false);assert.match(await p.locator('.final-button').innerText(),/Approve Your Bill & Complete Registration/);if([390,1440].includes(width))await p.screenshot({path:`/private/tmp/campusflow-cf024/finish-${width}.png`,fullPage:true});await p.close();console.log('PASS final approval button and celebration layout '+width+'px');}
+}finally{await browser.close();}})().catch(e=>{console.error(e);process.exit(1)});
