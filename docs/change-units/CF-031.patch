+
+public partial class HousingWorkspaceAppService
+{
+    public async Task<HousingRecoveryPreview> PreviewRecoveryAsync(int periodId)
+    {
+        var draft = await Find(periodId) ?? throw new UserFriendlyException("There is no saved draft to recover.");
+        var review = await PrepareRecoveryAsync(draft);
+        var expected = review.Current.SelectMany(room => room.Occupants.Select(o => (room, o)))
+            .ToDictionary(x => x.o.StudentUid);
+        var added = Read(draft.RoomsJson).SelectMany(x => x.Occupants).Select(x => x.StudentUid)
+            .Except(Read(draft.BaselineJson).SelectMany(x => x.Occupants).Select(x => x.StudentUid));
+        foreach (var id in added)
+        {
+            var live = await _writer.GetAssignedRoomAsync(id, periodId);
+            if (expected.TryGetValue(id, out var row) ? live is null || !SameRoom(live.Value, row.room) : live is not null)
+                throw new UserFriendlyException("The live API and housing snapshot disagree. No recovery changes were made; review again after Elements has settled.");
+        }
+        return review.Preview;
+    }
+
+    [Audited]
+    [UnitOfWork(IsDisabled = true)]
+    public Task<HousingWorkspaceState> ResumeCommuterAssignmentsAsync(RecoverHousingDraftInput input)
+    {
+        if (!input.Confirmed || string.IsNullOrWhiteSpace(input.Reason) || input.Reason.Trim().Length > 500 ||
+            input.RunId == Guid.Empty || string.IsNullOrWhiteSpace(input.RecoveryRevision))
+            throw new UserFriendlyException("Review the recovery preview, confirm the live assignments and housing batch, and enter a reason (maximum 500 characters).");
+        return ApplyCoreAsync(new ApplyHousingDraftInput
+        {
+            PeriodId = input.PeriodId, Revision = input.Revision, Confirmed = true, RateRevision = ""
+        }, input);
+    }
+
+    private async Task<(HousingRecoveryPreview Preview, List<HousingWorkspaceRoom> Current, List<int> Remaining)>
+        PrepareRecoveryAsync(HousingAssignmentDraft draft)
+    {
+        _writer.EnsureWriteEnabled();
+        var progress = HousingApplyProgress.Read(draft);
+        if (progress?.Status != "Needs review" || progress.FinishedAt is null ||
+            progress.BeforeJson != draft.BaselineJson || progress.DesiredJson != draft.RoomsJson)
+            throw new UserFriendlyException("Recovery requires a stopped partial apply and its unchanged saved plan. A running or replaced plan cannot be resumed.");
+        var before = Read(draft.BaselineJson);
+        var desired = Read(draft.RoomsJson);
+        var current = await _elements.GetRoomsAsync(draft.PeriodId);
+        (List<int> Added, List<int> Remaining) plan;
+        try { plan = HousingCommuterRecovery.Review(before, desired, current); }
+        catch (ArgumentException error) { throw new UserFriendlyException(error.Message); }
+        var identity = new
+        {
+            Tenant = Tenant(), User = CurrentUser.Id, draft.Id, draft.PeriodId, draft.ConcurrencyStamp,
+            progress.RunId, draft.BaselineJson, draft.RoomsJson,
+            Rooms = current.OrderBy(x => x.Id).Select(room => new
+            {
+                room.Id, room.Building, room.Name, room.Capacity,
+                Students = room.Occupants.Select(x => x.StudentUid).Order().ToArray()
+            }).ToArray()
+        };
+        return (new HousingRecoveryPreview
+        {
+            PeriodId = draft.PeriodId, RunId = progress.RunId, Revision = draft.ConcurrencyStamp,
+            RecoveryRevision = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(JsonSerializer.Serialize(identity)))),
+            SavedAssignments = desired.Sum(x => x.Occupants.Count), AlreadyAssigned = plan.Added.Count - plan.Remaining.Count,
+            RemainingAssignments = plan.Remaining.Count, Failure = HousingApplyFailure.Description(progress.FailureCode)
+        }, current, plan.Remaining);
+    }
+}
diff --git a/src/CampusFlow.Domain/Housing/HousingCommuterRecovery.cs b/src/CampusFlow.Domain/Housing/HousingCommuterRecovery.cs
new file mode 100644
index 0000000..3027d6d
--- /dev/null
+++ b/src/CampusFlow.Domain/Housing/HousingCommuterRecovery.cs
@@ -0,0 +1,54 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace CampusFlow.Housing;
+
+// Recovery is deliberately limited to additive commuter assignments. Residential charges,
+// moves, removals, capacity edits and unrelated live changes require a separate review.
+public static class HousingCommuterRecovery
+{
+    public static (List<int> Added, List<int> Remaining) Review(
+        List<HousingWorkspaceRoom> before, List<HousingWorkspaceRoom> desired,
+        List<HousingWorkspaceRoom> current)
+    {
+        HousingWorkspacePlanner.Compare(before, desired);
+        HousingWorkspacePlanner.Compare(before, current, requireCapacityCompliance: false);
+        foreach (var room in before)
+        {
+            var next = desired.Single(x => x.Id == room.Id);
+            var live = current.Single(x => x.Id == room.Id);
+            if (next.Capacity != room.Capacity || live.Capacity != room.Capacity ||
+                next.Name != room.Name || next.Building != room.Building ||
+                live.Name != room.Name || live.Building != room.Building)
+                throw new ArgumentException("Recovery requires unchanged room identities and capacities.");
+        }
+        var old = Assignments(before);
+        var planned = Assignments(desired);
+        var actual = Assignments(current);
+        foreach (var (id, row) in old)
+            if (!planned.TryGetValue(id, out var next) || next.Room.Id != row.Room.Id ||
+                next.Occupant.Rate != row.Occupant.Rate ||
+                next.Occupant.IntentionalSingle != row.Occupant.IntentionalSingle ||
+                !actual.TryGetValue(id, out var live) || live.Room.Id != row.Room.Id)
+                throw new ArgumentException("Recovery cannot include moves, removals, rate changes or changed existing assignments.");
+        var added = planned.Keys.Except(old.Keys).Order().ToList();
+        if (added.Count == 0 || added.Any(id =>
+                !IsCommuter(planned[id].Room.Building) || planned[id].Occupant.IntentionalSingle ||
+                planned[id].Occupant.Rate != "Standard"))
+            throw new ArgumentException("This recovery supports only added commuter assignments with no housing charge.");
+        foreach (var (id, row) in actual)
+            if (!planned.TryGetValue(id, out var next) || next.Room.Id != row.Room.Id)
+                throw new ArgumentException("Elements contains an unexpected assignment. The saved plan was preserved; resolve the conflict before recovery.");
+        return (added, added.Where(id => !actual.ContainsKey(id)).ToList());
+    }
+
+    private static bool IsCommuter(string building) =>
+        string.Equals(building.Trim(), "Commuter", StringComparison.OrdinalIgnoreCase) ||
+        string.Equals(building.Trim(), "Commuter Dorm", StringComparison.OrdinalIgnoreCase);
+
+    private static Dictionary<int, (HousingWorkspaceRoom Room, HousingWorkspaceOccupant Occupant)>
+        Assignments(List<HousingWorkspaceRoom> rooms) => rooms
+            .SelectMany(room => room.Occupants.Select(occupant => (Room: room, Occupant: occupant)))
+            .ToDictionary(x => x.Occupant.StudentUid);
+}
diff --git a/src/CampusFlow.Domain/Housing/HousingRequestException.cs b/src/CampusFlow.Domain/Housing/HousingRequestException.cs
new file mode 100644
index 0000000..1736b11
--- /dev/null
+++ b/src/CampusFlow.Domain/Housing/HousingRequestException.cs
@@ -0,0 +1,43 @@
+using System;
+using System.Net.Http;
+
+namespace CampusFlow.Housing;
+
+// Only fixed categories cross the integration boundary; never persist vendor response
+// bodies or arbitrary exception messages in a student-facing/admin draft.
+public sealed class HousingRequestException(string failureCode, int statusCode)
+    : InvalidOperationException(HousingApplyFailure.Description(failureCode))
+{
+    public string FailureCode { get; } = failureCode;
+    public int StatusCode { get; } = statusCode;
+}
+
+public static class HousingApplyFailure
+{
+    public static string ResponseCode(int status, string body) =>
+        body.Contains("No rent data available for this room", StringComparison.OrdinalIgnoreCase) ? "rent-setup" :
+        body.Contains("room is full", StringComparison.OrdinalIgnoreCase) ? "capacity" :
+        body.Contains("already assigned", StringComparison.OrdinalIgnoreCase) ? "conflict" :
+        status switch { 409 => "conflict", >= 500 => "unavailable", _ => "rejected" };
+
+    public static string Code(Exception error) => error switch
+    {
+        HousingRequestException request => request.FailureCode,
+        OperationCanceledException => "interrupted",
+        TimeoutException => "timeout",
+        HttpRequestException => "connection",
+        _ => "unconfirmed"
+    };
+
+    public static string Description(string? code) => code switch
+    {
+        "rent-setup" => "Elements requires rent setup for the selected room. Review the housing period configuration.",
+        "capacity" => "Elements rejected the room capacity. Review the live room and its occupants.",
+        "conflict" => "Elements reported a housing conflict. Review its room assignment screen before resuming.",
+        "rejected" => "Elements rejected the housing request. Review the housing period and assignment configuration.",
+        "unavailable" => "The Elements housing service was unavailable. Verify the live result before resuming.",
+        "connection" => "The connection to Elements failed. The last update may be unconfirmed; verify its live result.",
+        "timeout" or "interrupted" => "The housing request was interrupted. Verify the live result before resuming.",
+        _ => "The last housing operation could not be confirmed. Review the live assignments and housing batch."
+    };
+}
