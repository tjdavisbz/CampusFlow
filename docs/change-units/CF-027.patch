+            SELECT CASE WHEN t.Term >= cutoff.Term THEN 1 ELSE 0 END
+            FROM dbo.TermCalendar t CROSS JOIN dbo.TermCalendar cutoff
+            WHERE t.TermCalendarID=@Term AND LTRIM(RTRIM(cutoff.TextTerm))='Spring 2027';
