+    {var(gateway,http,_,_)=Setup();http.Entries.Add(Entry());http.Entries.Add(Entry());await Assert.ThrowsAsync<InvalidOperationException>(()=>gateway.FindAsync(Target));Assert.Empty(http.Posts);}
